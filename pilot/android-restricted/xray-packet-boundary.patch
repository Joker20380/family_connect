diff --git a/proxy/tun/family_endpoint.go b/proxy/tun/family_endpoint.go
new file mode 100644
index 00000000..062625d3
--- /dev/null
+++ b/proxy/tun/family_endpoint.go
@@ -0,0 +1,15 @@
+package tun
+
+import (
+	"context"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+)
+
+type familyEndpoint struct { endpoint stack.LinkEndpoint }
+func (link familyEndpoint) newEndpoint() (stack.LinkEndpoint, error) { return link.endpoint, nil }
+func (link familyEndpoint) Start() error { return nil }
+func (link familyEndpoint) Close() error { return nil }
+
+func NewEndpointStack(ctx context.Context, endpoint stack.LinkEndpoint, handler ConnectionHandler) (Stack, error) {
+	return NewStack(ctx, StackOptions{Tun: familyEndpoint{endpoint}}, handler)
+}
