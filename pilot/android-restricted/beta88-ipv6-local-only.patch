+package tcpforward
+
+import (
+	"context"
+	"io"
+	"net"
+	"net/netip"
+	"testing"
+	"time"
+)
+
+func TestIPv6DestinationActualSocket(test *testing.T) {
+	listener, err := net.Listen("tcp6", "[::1]:0")
+	if err != nil {
+		test.Fatal(err)
+	}
+	defer listener.Close()
+	finished := make(chan error, 1)
+	go func() {
+		accepted, err := listener.Accept()
+		if err != nil {
+			finished <- err
+			return
+		}
+		defer accepted.Close()
+		accepted.SetDeadline(time.Now().Add(time.Second))
+		_, err = io.Copy(accepted, accepted)
+		finished <- err
+	}()
+	address := netip.MustParseAddr("2606:4700:4700::1111")
+	metrics := &DestinationMetrics{}
+	connection, err := connect(context.Background(), OpenRequest{Host: "ipv6.fixture", Port: 443}, Policy{Metrics: metrics},
+		fixedResolver{addresses: []netip.Addr{address}}, func(ctx context.Context, network, destination string) (socket, error) {
+			if destination != "[2606:4700:4700::1111]:443" {
+				test.Fatal("unpinned destination")
+			}
+			raw, err := (&net.Dialer{}).DialContext(ctx, "tcp6", listener.Addr().String())
+			if err != nil {
+				return nil, err
+			}
+			return raw.(*net.TCPConn), nil
+		})
+	if err != nil {
+		test.Fatal(err)
+	}
+	payload := []byte("synthetic-public-AAAA-local-socket-fixture")
+	if _, err = connection.Write(payload); err != nil {
+		test.Fatal(err)
+	}
+	received := make([]byte, len(payload))
+	if _, err = io.ReadFull(connection, received); err != nil || string(received) != string(payload) {
+		test.Fatal("IPv6 echo", err)
+	}
+	connection.Close()
+	if err = <-finished; err != nil {
+		test.Fatal(err)
+	}
+	if metrics.Snapshot().IPv6Selected != 1 {
+		test.Fatal("family attribution")
+	}
+}
