FROM python:3.13-slim AS base
WORKDIR /app
COPY control/requirements.txt control/requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock

FROM base AS tests
COPY device_identity/requirements.lock /tmp/identity-requirements.lock
RUN pip install --no-cache-dir -r /tmp/identity-requirements.lock
COPY control /app/control
COPY tests /app/tests
COPY scripts /app/scripts
COPY device_identity /app/device_identity
COPY provisioning /app/provisioning
COPY telemetry /app/telemetry
# Stage 5 reuses desktop verification/backend code; package tests need the
# complete public six-file bundle and its version. These stay in the tests stage.
COPY VERSION /app/VERSION
COPY clients/desktop/app.py clients/desktop/backend.py clients/desktop/profile_config.py clients/desktop/updates.py clients/desktop/update.pub clients/desktop/install-linux.sh /app/clients/desktop/
RUN python -m pytest -q && touch /tmp/tests-passed

FROM base AS runtime
COPY --from=tests /tmp/tests-passed /app/tests-passed
COPY control /app/control
COPY scripts /app/scripts
ENV PYTHONPATH=/app
CMD ["uvicorn", "control.app:app", "--host", "0.0.0.0", "--port", "8080", "--no-access-log"]
