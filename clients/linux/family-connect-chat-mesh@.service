[Unit]
Description=Family Connect service-only MESH chat for desktop user %i
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I -S /usr/local/lib/family-connect-mesh/mesh_chat_service.py %i
TimeoutStopSec=30
KillMode=control-group
Restart=on-failure
RestartSec=5
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
StateDirectory=family-connect-mesh
StateDirectoryMode=0700
ReadWritePaths=/run
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_CHOWN
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
