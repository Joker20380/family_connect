[Unit]
Description=Family Connect fixed protected chat access for desktop user %i
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /usr/local/lib/family-connect-mesh/chat_direct_host.py %i
TimeoutStopSec=30
KillMode=control-group
Restart=on-failure
RestartSec=5
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_CHOWN
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
