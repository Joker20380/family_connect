[Unit]
Description=Family Connect Auto for desktop user %i
After=network.target systemd-resolved.service
Requires=systemd-resolved.service
StartLimitIntervalSec=300
StartLimitBurst=6

[Service]
Type=notify
NotifyAccess=main
FileDescriptorStoreMax=1
FileDescriptorStorePreserve=restart
ExecStart=/usr/bin/python3 -I /usr/local/lib/family-connect-mesh/auto_service.py serve %i
ExecStopPost=/usr/bin/python3 -I /usr/local/lib/family-connect-mesh/auto_service.py cleanup %i
TimeoutStopSec=45
KillMode=control-group
Restart=on-failure
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=30
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
StateDirectory=family-connect-auto family-connect-mesh
StateDirectoryMode=0700
ReadWritePaths=/run -/etc/family-connect/awg -/etc/family-connect/tcp
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_CHOWN
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
