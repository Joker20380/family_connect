diff --git a/deploy/friends/support-bindings-read.py b/deploy/friends/support-bindings-read.py
index cf069695..1dee3484 100644
--- a/deploy/friends/support-bindings-read.py
+++ b/deploy/friends/support-bindings-read.py
@@ -11,0 +12,11 @@ import importlib.util
+def aliases_module(root):
+    source = root / 'pseudonyms.py'
+    info = source.lstat()
+    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o022:
+        raise ValueError('Unavailable')
+    spec = importlib.util.spec_from_file_location('pseudonyms', source)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
@@ -20,0 +32,4 @@ def read(path):
+    aliases_path = path.parent / 'pseudonym-aliases.json'
+    if aliases_path.exists():
+        module = aliases_module(path.parent)
+        document = module.unseal(document, 'support', module.load(aliases_path))
@@ -49,0 +65,4 @@ if __name__ == '__main__':
+            aliases_path = root / 'pseudonym-aliases.json'
+            if aliases_path.exists():
+                aliases = aliases_module(root)
+                value = aliases.seal(value, 'notifications', key.read_bytes(), aliases.load(aliases_path))
