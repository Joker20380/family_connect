+func TestSpeedGroupExactFourAndUnselectedIdentity(test *testing.T) {
+	_, identities, put := groupFixture(test)
+	members := make([]string, 4)
+	for index := range members {
+		members[index] = groupTarget(identities[index])
+	}
+	for _, suffix := range []string{"", "\n"} {
+		put("speed-targets", strings.Join(members, "\n")+suffix)
+		for index, identity := range identities {
+			expected := sessionprofile.P1
+			if index == 4 {
+				expected = sessionprofile.P0
+			}
+			actual, err := speedPolicy(identity)
+			if err != nil || actual != expected {
+				test.Fatal(index, actual, err)
+			}
+			if lifecyclePolicy(identity) != (index == 0) {
+				test.Fatal("diagnostic scope expanded", index)
+			}
+		}
+	}
