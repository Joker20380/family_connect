+def admission_policy(raw):
+    policy = parse(raw)
+    require(type(policy) is dict)
+    if set(policy) == {'version', 'eligibility'}:
+        require(type(policy['version']) is int and policy['version'] == 2
+                and policy['eligibility'] == 'all_activated')
