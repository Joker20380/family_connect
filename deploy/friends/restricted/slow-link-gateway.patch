+func TestPerformanceTracksAdaptiveAdmissionAndLoss(test *testing.T) {
+	config := DefaultConfig()
+	config.SendWindow, config.ReceiveWindow = 32, 32
+	sender := newEngine(config, epoch{1}, time.Unix(100, 0))
+	receiver := newEngine(config, epoch{2}, sender.started)
+	sender.remote, sender.remoteWindow, sender.remoteSize = receiver.local, 32, config.Payload
+	receiver.remote, receiver.remoteWindow, receiver.remoteSize = sender.local, 32, config.Payload
+	for index := 0; index < 4; index++ {
+		packet, err := sender.send([]byte{byte(index)}, sender.started)
+		if err != nil {
+			test.Fatal(err)
+		}
+		if _, err := receiver.input(packet, sender.started); err != nil {
+			test.Fatal(err)
+		}
+	}
+	if value := sender.perfSnapshot(sender.started); value.EffectiveWindow != 4 || value.RetainedBytes != 4 || value.SlotSpan != 4 {
+		test.Fatal("initial flight accounting")
+	}
+	for range 4 {
+		_, acknowledgement := receiver.consume()
+		if _, err := sender.input(acknowledgement, sender.started); err != nil {
+			test.Fatal(err)
+		}
+	}
+	if value := sender.perfSnapshot(sender.started); value.EffectiveWindow != 5 || value.ReleasedBytes != 4 || value.RetainedBytes != 0 {
+		test.Fatal("consumed flight accounting")
+	}
+	for sender.writable() {
+		if _, err := sender.send([]byte{1}, sender.started); err != nil {
+			test.Fatal(err)
+		}
+	}
+	if _, err := sender.tick(sender.started.Add(time.Second)); err != nil {
+		test.Fatal(err)
+	}
+	if value := sender.perfSnapshot(sender.started.Add(time.Second)); value.EffectiveWindow != 2 || value.RetainedBytes != 5 || value.SlotSpan != 5 || value.ReleasedBytes != 4 {
+		test.Fatal("loss hid retained data or reported the wrong window")
+	}
+}
