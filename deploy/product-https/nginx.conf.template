worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr crit;
events { worker_connections 128; }
http {
    access_log off;
    server_tokens off;
    client_body_temp_path /tmp/client-body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    client_max_body_size 8k;
    client_body_buffer_size 8k;
    client_header_buffer_size 1k;
    large_client_header_buffers 2 4k;
    client_header_timeout 5s;
    client_body_timeout 5s;
    send_timeout 10s;
    keepalive_timeout 10s;
    reset_timedout_connection on;
    map $server_name $global_key { default family-connect; }
    limit_req_zone $binary_remote_addr zone=per_ip:1m rate=2r/s;
    limit_req_zone $global_key zone=global_rate:1m rate=10r/s;
    limit_conn_zone $binary_remote_addr zone=connections:1m;
    limit_conn_zone $global_key zone=global_connections:1m;
    limit_req_status 429;
    limit_conn_status 429;
    server {
        listen 80;
        server_name @IP@;
        location ~ ^/\.well-known/acme-challenge/[A-Za-z0-9_-]+$ {
            root /var/www/acme;
            default_type text/plain;
            limit_except GET { deny all; }
        }
        location / { return 404; }
    }
    server {
        listen 8443 ssl;
        server_name @IP@;
        ssl_certificate /etc/letsencrypt/live/family-connect-product/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/family-connect-product/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_tickets off;
        limit_conn connections 8;
        limit_conn global_connections 32;
        limit_req zone=per_ip burst=8 nodelay;
        limit_req zone=global_rate burst=20 nodelay;
        add_header Cache-Control no-store always;
        add_header X-Content-Type-Options nosniff always;
        if ($args != "") { return 400; }
        location ~ ^/v2/(registration/(challenge|complete)|provisioning/(challenge|fetch))$ {
            if ($request_method != POST) { return 405; }
            proxy_pass http://127.0.0.1:18082;
            proxy_http_version 1.1;
            proxy_set_header Host 127.0.0.1;
            proxy_set_header Connection "";
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto https;
            proxy_connect_timeout 2s;
            proxy_send_timeout 5s;
            proxy_read_timeout 10s;
            proxy_request_buffering on;
            proxy_buffering on;
            proxy_buffers 8 16k;
            proxy_max_temp_file_size 0;
            proxy_hide_header Cache-Control;
            proxy_hide_header X-Content-Type-Options;
        }
        location / { return 404; }
    }
}
