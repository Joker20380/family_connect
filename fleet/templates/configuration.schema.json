{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic instance runtime binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "instance_id", "logical_gateway", "bundle_id", "roles"],
  "properties": {
    "schema": {"const": 1},
    "instance_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$"},
    "logical_gateway": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$"},
    "bundle_id": {"type": "string", "pattern": "^gw-[0-9a-f]{32}$"},
    "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["awg", "tcp", "mesh", "profile-reader", "publisher", "renewal", "snapshot", "restricted-sync", "mailbox", "load-monitor", "monitoring"]}}
  }
}
