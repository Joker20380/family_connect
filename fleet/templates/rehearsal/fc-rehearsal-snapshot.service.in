[Unit]
Description=Disposable Family Connect rehearsal snapshot
After=fc-rehearsal-mesh.service
Requires=fc-rehearsal-mesh.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=oneshot
User=fc-rehearsal
Group=fc-rehearsal
WorkingDirectory=/opt/family-connect/current
ExecStartPre=/usr/bin/python3 -I -B /opt/family-connect/current/runtime/expiry_guard.py /etc/family-connect/rehearsal/{{BUNDLE_ID}}/metadata.json
ExecStart=/usr/bin/python3 -I -B /opt/family-connect/current/runtime/ready_wait.py /run/family-connect-rehearsal/{{INSTANCE_ID}}/ready.json
Restart=no
RestartSec=3
TimeoutStartSec=45
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Environment=LC_ALL=C
StandardOutput=null
StandardError=null
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
