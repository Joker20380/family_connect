FROM python:3.13-slim
WORKDIR /app
COPY control/requirements.lock /tmp/control-requirements.lock
COPY device_identity/requirements.lock /tmp/identity-requirements.lock
RUN pip install --no-cache-dir -r /tmp/control-requirements.lock -r /tmp/identity-requirements.lock
COPY control /app/control
COPY device_identity /app/device_identity
COPY provisioning /app/provisioning
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=3).read()"
CMD ["python", "-m", "uvicorn", "control.product.api:app_from_env", "--factory", "--host", "0.0.0.0", "--port", "8080", "--no-access-log"]
