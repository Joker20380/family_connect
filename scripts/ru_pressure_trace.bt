}
tracepoint:sched:sched_process_fork /pid == $1/ { @child[(uint64)args->child_pid] = nsecs; }
tracepoint:sched:sched_process_exec /@child[(uint64)pid]/ {
  @engine[(uint64)pid] = (uint64)0;
  if (comm == "awg") { @engine[(uint64)pid] = (uint64)1; }
  if (comm == "xray") { @engine[(uint64)pid] = (uint64)2; }
}
tracepoint:sched:sched_process_exit /tid == pid && @child[(uint64)pid]/ {
  printf("EV Q %llu %llu %llu 0 0\n", nsecs, @engine[(uint64)pid], nsecs - @child[(uint64)pid]);
