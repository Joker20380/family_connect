#!/usr/bin/env python3
"""Operator-only safe evidence export; no SSH, decryption or web authority."""

import argparse
from pathlib import Path
import sys
import time

sys.path.insert(0,str(Path(__file__).resolve().parents[1]))

from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
from fleet.contracts import canonical, load
from fleet.evidence import KINDS, project
from fleet.private_files import read_private, write_private

parser=argparse.ArgumentParser(allow_abbrev=False)
parser.add_argument('--kind',choices=KINDS,required=True)
for name in ('source','permit','authority-key','operation-id','bundle-id','output'):
    parser.add_argument('--'+name,required=True)
arguments=parser.parse_args()
try:
    key=Ed25519PrivateKey.from_private_bytes(read_private(arguments.authority_key,limit=32))
    receipt=project(arguments.kind,load(read_private(arguments.source)),load(read_private(arguments.permit)),key,
        operation_id=arguments.operation_id,bundle_id=arguments.bundle_id,issued_at=int(time.time()))
    write_private(Path(arguments.output).absolute(),canonical(receipt))
    print(canonical(receipt).decode())
except Exception:
    print('{"result":"REJECTED","error":"evidence_export_failed"}')
    raise SystemExit(1) from None
