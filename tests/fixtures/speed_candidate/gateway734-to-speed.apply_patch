*** Add File: roombroker/speed_policy_linux.go
+package roombroker
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"github.com/Joker20380/family_connect/carrier/sessionprofile"
+)
+
+func speedPolicy(identity Identity) (sessionprofile.Profile, error) {
+	value, err := muxOperatorValue("speed-profile")
+	if err != nil {
+		return sessionprofile.P0, err
+	}
+	profile, err := sessionprofile.Parse(value)
+	if err != nil {
+		return sessionprofile.P0, Code("speed_profile_configuration")
+	}
+	if profile == sessionprofile.P0 {
+		return profile, nil
+	}
+	target, err := muxOperatorValue("speed-target")
+	if err != nil {
+		return sessionprofile.P0, err
+	}
+	decoded, err := hex.DecodeString(target)
+	if err != nil || len(decoded) != 16 {
+		return sessionprofile.P0, Code("speed_profile_configuration")
+	}
+	keyHash := sha256.Sum256(identity.PublicKey[:])
+	if target != hex.EncodeToString(keyHash[:16]) {
+		return sessionprofile.P0, nil
+	}
+	pacing, err := muxOperatorValue("rtp-pacing")
+	if err != nil || (pacing != "" && pacing != "OFF") {
+		return sessionprofile.P0, Code("speed_profile_configuration")
+	}
+	return profile, nil
+}
