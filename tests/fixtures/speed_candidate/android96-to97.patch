+func TestQueueRetryHeldLocalWriter(test *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 4*time.Second)
+	defer cancel()
+	if os.Getenv("FC_QUEUE_COMPLETION_EXPECTED") == "1" {
