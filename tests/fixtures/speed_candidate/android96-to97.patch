+		"rtp_writes_before_release": written, "queue_hold_ms": 340, "goodput_before_release": 0, "terminal": stats.Terminal,
+		"byte_exact": receiveErr == nil && bytes.Equal(data, bytes.Repeat([]byte{42}, config.Payload)), "send_ok": sendErr == nil,
