+package roombroker
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestLifecycleOnlyExistingOwnerTarget(test *testing.T) {
+	directory := test.TempDir()
+	os.Chmod(directory, 0700)
+	test.Setenv("FC_DIAGNOSTIC_CONTROL_DIR", directory)
+	var owner, other Identity
+	owner.PublicKey[0] = 1
+	other.PublicKey[0] = 2
+	hash := sha256.Sum256(owner.PublicKey[:])
+	path := filepath.Join(directory, "speed-target")
+	if err := os.WriteFile(path, []byte(hex.EncodeToString(hash[:16])), 0600); err != nil {
+		test.Fatal(err)
+	}
+	if !lifecyclePolicy(owner) || lifecyclePolicy(other) {
+		test.Fatal("observer escaped owner scope")
+	}
+	os.Chmod(path, 0644)
+	if lifecyclePolicy(owner) {
+		test.Fatal("unsafe operator file accepted")
+	}
+}
