+func TestPacingBoundedCloseSlowWriter(test *testing.T) {
+	pace := New(context.Background(), true)
+	entered, release := make(chan struct{}), make(chan struct{})
+	writer := pace.BindLocalStream(&interceptor.StreamInfo{SSRC: 1}, interceptor.RTPWriterFunc(func(header *rtp.Header, payload []byte, _ interceptor.Attributes) (int, error) {
+		close(entered)
+		<-release
+		return header.MarshalSize() + len(payload), nil
+	}))
+	results := make(chan error, MaxPending)
+	go func() { _, err := writer.Write(&rtp.Header{SSRC: 1}, make([]byte, 1188), nil); results <- err }()
+	<-entered
+	for index := 1; index < MaxPending; index++ {
+		go func() { _, err := writer.Write(&rtp.Header{SSRC: 1}, make([]byte, 1188), nil); results <- err }()
+	}
+	deadline := time.After(2 * time.Second)
+	for pace.Snapshot().Pending != MaxPending {
+		select {
+		case <-deadline:
+			test.Fatal("not admitted")
+		case <-time.After(time.Millisecond):
+		}
