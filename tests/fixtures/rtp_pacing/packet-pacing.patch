+			defer cancel()
+			pace := New(ctx, true)
+			defer pace.Close()
+			pace.next = time.Now().Add(10 * time.Second)
+			info := &interceptor.StreamInfo{SSRC: 3}
+			called := false
+			writer := pace.BindLocalStream(info, interceptor.RTPWriterFunc(func(*rtp.Header, []byte, interceptor.Attributes) (int, error) { called = true; return 0, nil }))
+			switch operation {
+			case "cancel":
+				cancel()
+			case "unbind":
