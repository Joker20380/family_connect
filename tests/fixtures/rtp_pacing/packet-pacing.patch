+func (endpoint *countedQueueEndpoint) SendContext(ctx context.Context, data []byte) error {
+	point := sessiontrace.AttemptFrom(ctx)
+	if point.DataKnown && point.DataSequence == 1 {
+		endpoint.attempts.Add(1)
+	}
