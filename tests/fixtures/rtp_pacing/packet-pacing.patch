+package packetpace
+
+import (
+	"context"
+	"errors"
+	"io"
+	"sync"
+	"time"
+
+	"github.com/pion/interceptor"
+	"github.com/pion/rtcp"
+	"github.com/pion/rtp"
+)
+
+const FixedBytesPerSecond = 500000
+const MaxPacket = 1500
+const MaxPending = 16
+const MaxWait = time.Second
+
+var ErrCapacity = errors.New("packet pacing: capacity")
+
+type Histogram struct {
+	Count   [9]uint64
+	MaxNS   int64
+	TotalNS int64
+}
+
+func (histogram *Histogram) add(duration time.Duration) {
+	index := 0
+	for index < 8 && duration > [...]time.Duration{10 * time.Microsecond, 50 * time.Microsecond, 100 * time.Microsecond, 500 * time.Microsecond, time.Millisecond, 5 * time.Millisecond, 20 * time.Millisecond, 100 * time.Millisecond}[index] {
+		index++
+	}
+	histogram.Count[index]++
+	histogram.TotalNS += int64(duration)
+	histogram.MaxNS = max(histogram.MaxNS, int64(duration))
+}
+
+type Snapshot struct {
+	RateBytesPerSecond                                               int
+	ElapsedNS                                                        int64
+	Packets, RTPBytes, LocalWriteBytes, RTXPackets, Errors, Rejected uint64
+	Pending, PendingBytes, MaxPending, MaxPendingBytes               int
+	Spacing, Wait, SchedulerLate, CarrierQueueAge                    Histogram
+	CarrierQueueFramesMax                                            int
+	Bins                                                             [3]struct{ PeakPackets, PeakBytes uint64 }
+	FramePackets                                                     [9]uint64
+	RTCP                                                             [6]uint64
+	RTCPBytes                                                        uint64
+	NACK, TWCC, REMB                                                 bool
+	RTCPWrittenBytes, RTCPWrittenPackets                             uint64
+}
+
+type Pacer struct {
+	interceptor.NoOp
+	ctx         context.Context
+	cancel      context.CancelFunc
+	rate        int
+	permit      chan struct{}
+	slots       chan struct{}
+	now         func() time.Time
+	wait        func(context.Context, time.Duration) error
+	next        time.Time
+	mu          sync.Mutex
+	stats       Snapshot
+	start, last time.Time
+	bins        [3]struct {
+		index          int64
+		packets, bytes uint64
+	}
+	frameTimestamp, frameSSRC uint32
+	framePackets              int
+	streams                   map[uint32]streamLifetime
+}
+
+type streamLifetime struct {
+	info   *interceptor.StreamInfo
+	cancel context.CancelFunc
+}
+
+func New(ctx context.Context, paced bool) *Pacer {
+	lifetime, cancel := context.WithCancel(ctx)
+	pace := &Pacer{ctx: lifetime, cancel: cancel, permit: make(chan struct{}, 1), slots: make(chan struct{}, MaxPending), now: time.Now, streams: make(map[uint32]streamLifetime)}
+	if paced {
+		pace.rate = FixedBytesPerSecond
+	}
+	pace.permit <- struct{}{}
+	pace.wait = func(ctx context.Context, delay time.Duration) error {
+		if delay <= 0 {
+			return ctx.Err()
+		}
+		timer := time.NewTimer(delay)
+		defer timer.Stop()
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-timer.C:
+			return nil
+		}
+	}
+	pace.start = pace.now()
+	pace.stats.RateBytesPerSecond = pace.rate
+	return pace
+}
+
+func (pace *Pacer) NewInterceptor(string) (interceptor.Interceptor, error) { return pace, nil }
+func (pace *Pacer) Close() error                                           { pace.cancel(); return nil }
+
+func (pace *Pacer) BindLocalStream(info *interceptor.StreamInfo, writer interceptor.RTPWriter) interceptor.RTPWriter {
+	lifetime, cancel := context.WithCancel(pace.ctx)
+	pace.mu.Lock()
+	if old := pace.streams[info.SSRC]; old.cancel != nil {
+		old.cancel()
+	}
+	pace.streams[info.SSRC] = streamLifetime{info, cancel}
+	for _, feedback := range info.RTCPFeedback {
+		switch feedback.Type {
+		case "nack":
+			pace.stats.NACK = true
+		case "transport-cc":
+			pace.stats.TWCC = true
+		case "goog-remb":
+			pace.stats.REMB = true
+		}
+	}
+	pace.mu.Unlock()
+	return interceptor.RTPWriterFunc(func(header *rtp.Header, payload []byte, attributes interceptor.Attributes) (count int, err error) {
+		defer func() {
+			if err != nil {
+				pace.mu.Lock()
+				pace.stats.Errors++
+				pace.mu.Unlock()
+			}
+		}()
+		size := header.MarshalSize() + len(payload)
+		if size > MaxPacket || header.Padding {
+			return 0, ErrCapacity
+		}
+		select {
+		case pace.slots <- struct{}{}:
+		default:
+			pace.mu.Lock()
+			pace.stats.Rejected++
+			pace.mu.Unlock()
+			return 0, ErrCapacity
+		}
+		pace.mu.Lock()
+		pace.stats.Pending++
+		pace.stats.PendingBytes += size
+		pace.stats.MaxPending = max(pace.stats.MaxPending, pace.stats.Pending)
+		pace.stats.MaxPendingBytes = max(pace.stats.MaxPendingBytes, pace.stats.PendingBytes)
+		pace.mu.Unlock()
+		defer func() {
+			<-pace.slots
+			pace.mu.Lock()
+			pace.stats.Pending--
+			pace.stats.PendingBytes -= size
+			pace.mu.Unlock()
+		}()
+		ctx, end := context.WithTimeout(lifetime, MaxWait)
+		defer end()
+		started := pace.now()
+		select {
+		case <-ctx.Done():
+			return 0, ctx.Err()
+		case <-pace.permit:
+		}
+		defer func() { pace.permit <- struct{}{} }()
+		if err := ctx.Err(); err != nil {
+			return 0, err
+		}
+		if err := pace.wait(ctx, pace.next.Sub(pace.now())); err != nil {
+			return 0, err
+		}
+		if err := ctx.Err(); err != nil {
+			return 0, err
+		}
+		waking := pace.now()
+		count, err = writer.Write(header, payload, attributes)
+		if err == nil && count < size {
+			err = io.ErrShortWrite
+		}
+		written := pace.now()
+		pace.mu.Lock()
+		pace.stats.Wait.add(waking.Sub(started))
+		if waking.After(pace.next) && pace.next.After(started) {
+			pace.stats.SchedulerLate.add(waking.Sub(pace.next))
+		}
+		if err == nil {
+			pace.stats.Packets++
+			pace.stats.RTPBytes += uint64(size)
+			pace.stats.LocalWriteBytes += uint64(count)
+			if info.SSRCRetransmission != 0 && header.SSRC == info.SSRCRetransmission {
+				pace.stats.RTXPackets++
+			}
+			if !pace.last.IsZero() {
+				pace.stats.Spacing.add(written.Sub(pace.last))
+			}
+			pace.last = written
+			for index, width := range [...]time.Duration{time.Millisecond, 5 * time.Millisecond, 20 * time.Millisecond} {
+				bucket := &pace.bins[index]
+				position := int64(written.Sub(pace.start) / width)
+				if bucket.index != position {
+					bucket.index = position
+					bucket.packets = 0
+					bucket.bytes = 0
+				}
+				bucket.packets++
+				bucket.bytes += uint64(size)
+				pace.stats.Bins[index].PeakPackets = max(pace.stats.Bins[index].PeakPackets, bucket.packets)
+				pace.stats.Bins[index].PeakBytes = max(pace.stats.Bins[index].PeakBytes, bucket.bytes)
+			}
+			if pace.frameTimestamp != header.Timestamp || pace.frameSSRC != header.SSRC {
+				pace.framePackets = 0
+			}
+			pace.frameTimestamp, pace.frameSSRC = header.Timestamp, header.SSRC
+			pace.framePackets++
+			if header.Marker {
+				pace.stats.FramePackets[min(8, pace.framePackets)]++
+				pace.framePackets = 0
+			}
+		}
+		pace.mu.Unlock()
+		if pace.rate > 0 {
+			pace.next = written.Add(time.Duration(size) * time.Second / time.Duration(pace.rate))
+		}
+		return count, err
+	})
+}
+
+func (pace *Pacer) UnbindLocalStream(info *interceptor.StreamInfo) {
+	pace.mu.Lock()
+	defer pace.mu.Unlock()
+	if old := pace.streams[info.SSRC]; old.cancel != nil && old.info == info {
+		old.cancel()
+		delete(pace.streams, info.SSRC)
+	}
+}
+
+func (pace *Pacer) ObserveCarrierQueue(queued time.Time, depth int) {
+	if queued.IsZero() {
+		return
+	}
+	pace.mu.Lock()
+	defer pace.mu.Unlock()
+	pace.stats.CarrierQueueAge.add(pace.now().Sub(queued))
+	pace.stats.CarrierQueueFramesMax = max(pace.stats.CarrierQueueFramesMax, depth)
+}
+
+func (pace *Pacer) Snapshot() Snapshot {
+	pace.mu.Lock()
+	defer pace.mu.Unlock()
+	result := pace.stats
+	result.ElapsedNS = int64(pace.now().Sub(pace.start))
+	return result
+}
+
+func (pace *Pacer) BindRTCPReader(reader interceptor.RTCPReader) interceptor.RTCPReader {
+	return interceptor.RTCPReaderFunc(func(buffer []byte, attributes interceptor.Attributes) (int, interceptor.Attributes, error) {
+		count, attributes, err := reader.Read(buffer, attributes)
+		if err == nil {
+			packets, parseErr := rtcp.Unmarshal(buffer[:count])
+			if parseErr == nil {
+				pace.mu.Lock()
+				pace.stats.RTCPBytes += uint64(count)
+				for _, packet := range packets {
+					index := 5
+					switch packet.(type) {
+					case *rtcp.ReceiverReport:
+						index = 0
+					case *rtcp.TransportLayerNack:
+						index = 1
+					case *rtcp.TransportLayerCC:
+						index = 2
+					case *rtcp.ReceiverEstimatedMaximumBitrate:
+						index = 3
+					case *rtcp.PictureLossIndication:
+						index = 4
+					}
+					pace.stats.RTCP[index]++
+				}
+				pace.mu.Unlock()
+			}
+		}
+		return count, attributes, err
+	})
+}
+
+func (pace *Pacer) BindRTCPWriter(writer interceptor.RTCPWriter) interceptor.RTCPWriter {
+	return interceptor.RTCPWriterFunc(func(packets []rtcp.Packet, attributes interceptor.Attributes) (int, error) {
+		count, err := writer.Write(packets, attributes)
+		if err == nil && count > 0 {
+			pace.mu.Lock()
+			pace.stats.RTCPWrittenBytes += uint64(count)
+			pace.stats.RTCPWrittenPackets += uint64(len(packets))
+			pace.mu.Unlock()
+		}
+		return count, err
+	})
+}
