+			started := time.Now()
+			if _, err := writer.Write(&rtp.Header{}, []byte{1}, nil); err == nil {
+				test.Fatal("cancel lost")
+			}
+			if called || time.Since(started) > 2*time.Second {
+				test.Fatal("unbounded wait or late callback")
+			}
+		})
+	}
