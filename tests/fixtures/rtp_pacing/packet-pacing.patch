+package roombroker
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"github.com/Joker20380/family_connect/carrier/packetpace"
+)
+
+func packetPacingPolicy(ctx context.Context, identity Identity) (*packetpace.Pacer, error) {
+	mode, err := muxOperatorValue("rtp-pacing")
+	if err != nil {
+		return nil, err
+	}
+	if mode == "" || mode == "OFF" {
+		return nil, nil
+	}
+	if mode != "OBSERVE" && mode != "FIXED4M" {
+		return nil, Code("pacing_configuration")
+	}
+	target, err := muxOperatorValue("rtp-pacing-target")
+	if err != nil {
+		return nil, err
+	}
+	decoded, err := hex.DecodeString(target)
+	if err != nil || len(decoded) != 16 {
+		return nil, Code("pacing_configuration")
+	}
+	keyHash := sha256.Sum256(identity.PublicKey[:])
+	if target != hex.EncodeToString(keyHash[:16]) {
+		return nil, nil
+	}
+	return packetpace.New(ctx, mode == "FIXED4M"), nil
+}
