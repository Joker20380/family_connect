+package packetpace
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"testing"
+	"time"
+
+	"github.com/pion/interceptor"
+	"github.com/pion/interceptor/pkg/nack"
+	"github.com/pion/rtcp"
+	"github.com/pion/rtp"
+)
+
+func fakePacer(paced bool) (*Pacer, *time.Time) {
+	pace := New(context.Background(), paced)
+	now := time.Unix(100, 0)
+	pace.now = func() time.Time { return now }
+	pace.start = now
+	pace.wait = func(ctx context.Context, delay time.Duration) error {
+		if delay > 0 {
+			now = now.Add(delay)
+		}
+		return ctx.Err()
+	}
+	return pace, &now
+}
+
+func TestPacingExactIdlePartialAndTimestampWrap(test *testing.T) {
+	pace, clock := fakePacer(true)
+	defer pace.Close()
+	var arrivals []time.Time
+	var copied [][]byte
+	writer := pace.BindLocalStream(&interceptor.StreamInfo{SSRC: 1}, interceptor.RTPWriterFunc(func(header *rtp.Header, payload []byte, _ interceptor.Attributes) (int, error) {
+		arrivals = append(arrivals, *clock)
+		copied = append(copied, bytes.Clone(payload))
+		return header.MarshalSize() + len(payload) + 10, nil
+	}))
+	payload := bytes.Repeat([]byte{77}, 1188)
+	for index := 0; index < 5; index++ {
+		if index == 3 {
+			*clock = clock.Add(10 * time.Second)
+		}
+		if _, err := writer.Write(&rtp.Header{Version: 2, SSRC: 1, SequenceNumber: uint16(65534 + index), Timestamp: uint32(uint64(4294967294) + uint64(index)), Marker: true}, payload, nil); err != nil {
+			test.Fatal(err)
+		}
+	}
+	payload[0] = 0
+	for _, data := range copied {
+		if data[0] != 77 {
+			test.Fatal("payload ownership")
+		}
+	}
+	for _, index := range []int{1, 2, 4} {
+		if arrivals[index].Sub(arrivals[index-1]) != 2400*time.Microsecond {
+			test.Fatal("spacing or idle credit", arrivals)
+		}
+	}
+	if pace.Snapshot().Packets != 5 || pace.Snapshot().LocalWriteBytes != 6050 {
+		test.Fatal(pace.Snapshot())
+	}
+	short := pace.BindLocalStream(&interceptor.StreamInfo{SSRC: 2}, interceptor.RTPWriterFunc(func(*rtp.Header, []byte, interceptor.Attributes) (int, error) { return 1, nil }))
+	if _, err := short.Write(&rtp.Header{}, payload, nil); !errors.Is(err, io.ErrShortWrite) {
+		test.Fatal(err)
+	}
+	if pace.Snapshot().Packets != 5 {
+		test.Fatal("partial recorded as success")
+	}
