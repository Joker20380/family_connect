+
+func TestPacingEqualOfferedBudgetModel(test *testing.T) {
+	for _, scenario := range []string{"sufficient", "two_packet_queue", "reorder", "slow_consumer"} {
+		for _, paced := range []bool{false, true} {
+			pace, clock := fakePacer(paced)
+			start := *clock
+			linkRate := 1000000
+			capacity := 64
+			if scenario == "two_packet_queue" {
+				linkRate = 500000
+				capacity = 2
+			}
+			var queued []time.Time
+			var linkFinish, consumerFinish time.Time
+			var consumerQueue []time.Time
+			dropped, complete, totalPackets, maxQueue, maxConsumer := 0, 0, 0, 0, 0
+			frameOK := true
+			var lastDelivery time.Time
+			writer := pace.BindLocalStream(&interceptor.StreamInfo{SSRC: 1}, interceptor.RTPWriterFunc(func(header *rtp.Header, payload []byte, _ interceptor.Attributes) (int, error) {
+				size := header.MarshalSize() + len(payload)
+				totalPackets++
+				for len(queued) > 0 && !queued[0].After(*clock) {
+					queued = queued[1:]
+				}
+				if len(queued) >= capacity {
+					dropped++
+					frameOK = false
+				} else {
+					if linkFinish.Before(*clock) {
+						linkFinish = *clock
+					}
+					linkFinish = linkFinish.Add(time.Duration(size) * time.Second / time.Duration(linkRate))
+					queued = append(queued, linkFinish)
+					maxQueue = max(maxQueue, len(queued))
+				}
+				if header.Marker {
+					if frameOK {
+						complete++
+						lastDelivery = linkFinish.Add(20 * time.Millisecond)
+						if scenario == "reorder" {
+							lastDelivery = lastDelivery.Add(3 * time.Millisecond)
+						}
+						if scenario == "slow_consumer" {
+							if consumerFinish.Before(lastDelivery) {
+								consumerFinish = lastDelivery
+							}
+							consumerFinish = consumerFinish.Add(100 * time.Millisecond)
+							consumerQueue = append(consumerQueue, consumerFinish)
+							maxConsumer = max(maxConsumer, len(consumerQueue))
+							lastDelivery = consumerFinish
+						}
+					}
+					frameOK = true
+				}
+				return size, nil
+			}))
+			packetizer := rtp.NewPacketizer(1200, 96, 1, &codecs.VP8Payloader{EnablePictureID: true}, rtp.NewFixedSequencer(65520), 90000)
+			interval := 75 * time.Millisecond
+			if scenario == "slow_consumer" {
+				interval = 100 * time.Millisecond
+			}
+			for frame := 0; frame < 64; frame++ {
+				arrival := start.Add(time.Duration(frame) * interval)
+				if clock.Before(arrival) {
+					*clock = arrival
+				}
+				for len(consumerQueue) > 0 && !consumerQueue[0].After(*clock) {
+					consumerQueue = consumerQueue[1:]
+				}
+				if len(consumerQueue) >= 2 {
+					*clock = consumerQueue[0]
+					consumerQueue = consumerQueue[1:]
+				}
+				for _, packet := range packetizer.Packetize(make([]byte, 8233), 2970) {
+					if _, err := writer.Write(&packet.Header, packet.Payload, nil); err != nil {
+						test.Fatal(err)
+					}
+				}
+			}
+			snapshot := pace.Snapshot()
+			var lastUseful any
+			if !lastDelivery.IsZero() {
+				lastUseful = lastDelivery.Sub(start).Nanoseconds()
+			}
+			encoded, _ := json.Marshal(map[string]any{"scenario": scenario, "paced": paced, "input_frames": 64, "packets": totalPackets, "rtp_bytes": snapshot.RTPBytes, "complete_frames": complete, "dropped_packets": dropped, "link_queue_max_packets": maxQueue, "consumer_queue_max_frames": maxConsumer, "input_interval_ns": int64(interval), "offered_budget_interval_ns": int64(64 * interval), "last_useful_ns": lastUseful, "source_end_ns": clock.Sub(start).Nanoseconds(), "pacing": snapshot})
+			test.Log(string(encoded))
+			if scenario != "two_packet_queue" || paced {
+				if complete != 64 || dropped != 0 {
+					test.Fatal("unexpected delivery regression")
+				}
+			} else if dropped == 0 {
+				test.Fatal("burst fixture ineffective")
+			}
+			if maxQueue > capacity || maxConsumer > 2 {
+				test.Fatal("unbounded model")
+			}
+			pace.Close()
+		}
+	}
+}
+
+func BenchmarkPacingObservation(b *testing.B) {
+	for _, observed := range []bool{false, true} {
+		name := "plain"
+		if observed {
+			name = "bounded_histograms"
+		}
+		b.Run(name, func(b *testing.B) {
+			var writer interceptor.RTPWriter = interceptor.RTPWriterFunc(func(header *rtp.Header, payload []byte, _ interceptor.Attributes) (int, error) {
+				return header.MarshalSize() + len(payload), nil
+			})
+			if observed {
+				pace := New(context.Background(), false)
+				defer pace.Close()
+				writer = pace.BindLocalStream(&interceptor.StreamInfo{SSRC: 1}, writer)
+			}
+			header := &rtp.Header{SSRC: 1, Marker: true}
+			payload := make([]byte, 1188)
+			b.ReportAllocs()
+			b.ResetTimer()
+			for index := 0; index < b.N; index++ {
+				if _, err := writer.Write(header, payload, nil); err != nil {
+					b.Fatal(err)
+				}
+			}
+		})
+	}
