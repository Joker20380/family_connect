+package roombroker
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestPacingOperatorScopeAndLifetime(test *testing.T) {
+	directory := test.TempDir()
+	if err := os.Chmod(directory, 0700); err != nil {
+		test.Fatal(err)
+	}
+	test.Setenv("FC_DIAGNOSTIC_CONTROL_DIR", directory)
+	identity := Identity{PublicKey: [32]byte{1}}
+	digest := sha256.Sum256(identity.PublicKey[:])
+	write := func(name, value string) {
+		test.Helper()
+		if err := os.WriteFile(filepath.Join(directory, name), []byte(value), 0600); err != nil {
+			test.Fatal(err)
+		}
+	}
+	write("rtp-pacing-target", hex.EncodeToString(digest[:16]))
+	for _, mode := range []string{"OFF", "OBSERVE", "FIXED4M"} {
+		write("rtp-pacing", mode)
+		pace, err := packetPacingPolicy(context.Background(), identity)
+		if err != nil {
+			test.Fatal(err)
+		}
+		if mode == "OFF" {
+			if pace != nil {
+				test.Fatal("unexpected pacer")
+			}
+			continue
+		}
+		defer pace.Close()
+		if (pace.Snapshot().RateBytesPerSecond == 500000) != (mode == "FIXED4M") {
+			test.Fatal("wrong mode")
+		}
+		write("rtp-pacing", "OFF")
+		if (pace.Snapshot().RateBytesPerSecond == 500000) != (mode == "FIXED4M") {
+			test.Fatal("live reinterpretation")
+		}
+	}
+	write("rtp-pacing", "FIXED4M")
+	if pace, err := packetPacingPolicy(context.Background(), Identity{PublicKey: [32]byte{2}}); err != nil || pace != nil {
+		test.Fatal("other user changed", err)
+	}
+	write("rtp-pacing", "UNKNOWN")
+	if _, err := packetPacingPolicy(context.Background(), identity); err == nil {
+		test.Fatal("unknown accepted")
+	}
+	write("rtp-pacing", "FIXED4M")
+	write("rtp-pacing-target", "invalid")
+	if _, err := packetPacingPolicy(context.Background(), identity); err == nil {
+		test.Fatal("bad selector")
+	}
+	write("rtp-pacing-target", hex.EncodeToString(digest[:16]))
+	os.Chmod(filepath.Join(directory, "rtp-pacing"), 0644)
+	if _, err := packetPacingPolicy(context.Background(), identity); err == nil {
+		test.Fatal("unsafe permission")
+	}
+}
