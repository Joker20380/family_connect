+//go:build fc_perf_diagnostic && !fc_owner_diagnostic
+
+package reliablestream
+
+import (
+	"bytes"
+	"context"
+	"github.com/Joker20380/family_connect/carrier/sessiontrace"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+type observedMessage struct {
+	data     []byte
+	identity sessiontrace.ReceiveIdentity
+}
+type observedEndpoint struct {
+	in, out chan observedMessage
+	done    chan struct{}
+	once    sync.Once
+	trace   *sessiontrace.Recorder
+}
+
+func (endpoint *observedEndpoint) SendContext(ctx context.Context, data []byte) error {
+	point := sessiontrace.Boundary{Stage: "carrier_queued", Direction: "tx", Result: "ok", Total: 1}
+	point.CaptureTransport(ctx)
+	endpoint.trace.Boundary(point)
+	point.Stage = "carrier_written"
+	endpoint.trace.Boundary(point)
+	message := observedMessage{bytes.Clone(data), sessiontrace.NewReceiveIdentity(sessiontrace.Boundary{MessageKnown: true})}
+	select {
+	case endpoint.out <- message:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-endpoint.done:
+		return ErrClosed
+	}
+}
+func (endpoint *observedEndpoint) Recv(ctx context.Context) ([]byte, error) {
+	select {
+	case message := <-endpoint.in:
+		sessiontrace.ObserveReceived(ctx, message.identity)
+		return message.data, nil
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	case <-endpoint.done:
+		return nil, ErrClosed
+	}
+}
+func (endpoint *observedEndpoint) Close() error {
+	endpoint.once.Do(func() { close(endpoint.done) })
+	return nil
+}
+
+func TestTransportAdapterExport(test *testing.T) {
+	forward, reverse := make(chan observedMessage, 32), make(chan observedMessage, 32)
+	leftTrace, rightTrace := sessiontrace.New(strings.Repeat("c", 64), nil), sessiontrace.New(strings.Repeat("c", 64), nil)
+	leftEndpoint := &observedEndpoint{in: reverse, out: forward, done: make(chan struct{}), trace: leftTrace}
+	rightEndpoint := &observedEndpoint{in: forward, out: reverse, done: make(chan struct{}), trace: rightTrace}
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	left, err := New(sessiontrace.With(ctx, leftTrace), leftEndpoint, DefaultConfig())
+	if err != nil {
+		test.Fatal(err)
+	}
+	right, err := New(sessiontrace.With(ctx, rightTrace), rightEndpoint, DefaultConfig())
+	if err != nil {
+		test.Fatal(err)
+	}
+	defer left.Close()
+	defer right.Close()
+	if err = left.SendContext(ctx, []byte("adapter bytes")); err != nil {
+		test.Fatal(err)
+	}
+	time.Sleep(5 * time.Millisecond)
+	data, err := right.Recv(ctx)
+	if err != nil || string(data) != "adapter bytes" {
+		test.Fatal("byte exact", err)
+	}
+	for left.Stats().Flow.SendBase < 1 && ctx.Err() == nil {
+		time.Sleep(time.Millisecond)
+	}
+	if ctx.Err() != nil {
+		test.Fatal("no base release")
+	}
+	kinds := map[string]int{}
+	for _, trace := range []*sessiontrace.Recorder{leftTrace, rightTrace} {
+		for _, point := range trace.TransportSnapshot().Points {
+			kinds[point.Kind]++
+			if point.Kind == "data_decode" && (point.CarrierNS <= 0 || point.CarrierNS > point.NS) {
+				test.Fatal("carrier completion missing")
+			}
+		}
+	}
+	for _, kind := range []string{"submission", "data_carrier_written", "data_decode", "receive", "head_ready", "consume", "ack_created", "ack_carrier_queued", "ack_carrier_written", "ack_enqueue_return", "ack_decode", "ack_input", "release"} {
+		if kinds[kind] == 0 {
+			test.Fatal("missing", kind)
+		}
+	}
+	if kinds["consume"] != 1 {
+		test.Fatal("consume count", kinds)
+	}
+}
