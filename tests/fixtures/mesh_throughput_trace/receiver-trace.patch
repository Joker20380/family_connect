@@ -0,0 +1,72 @@
+package reliablestream
+
+import (
+	"github.com/Joker20380/family_connect/carrier/sessiontrace"
+	"time"
+)
+
+func (packet frame) traceWire() string {
+	if !sessiontrace.PerformanceEnabled {
+		return ""
+	}
+	if packet.kind == ackFrame {
+		return sessiontrace.WireTag(packet.target[:], packet.source[:])
+	}
+	return sessiontrace.WireTag(packet.source[:], packet.target[:])
+}
+
+func (state *engine) tracePoint(kind string, sequence uint64, size, attempt int, first, now time.Time) {
+	if !sessiontrace.PerformanceEnabled {
+		return
+	}
+	point := sessiontrace.TransportPoint{Kind: kind, NS: sessiontrace.PerformanceTime(now), Wire: state.packet(dataFrame).traceWire(), Sequence: sequence, Bytes: size, Attempt: attempt}
+	if !first.IsZero() {
+		point.FirstNS = sessiontrace.PerformanceTime(first)
+	}
+	state.trace.RecordTransport(point)
+}
+
+func (state *engine) traceHead(now time.Time) {
+	if !sessiontrace.PerformanceEnabled {
+		return
+	}
+	if len(state.buffer[state.receive]) == 0 {
+		state.headReady = time.Time{}
+		return
+	}
+	if !state.headReady.IsZero() && state.headSequence == state.receive {
+		return
+	}
+	state.headReady, state.headSequence = now, state.receive
+	state.trace.RecordTransport(sessiontrace.TransportPoint{Kind: "head_ready", NS: sessiontrace.PerformanceTime(now), Wire: state.packet(ackFrame).traceWire(), Sequence: state.receive, Bytes: len(state.buffer[state.receive]), Head: state.receive, Buffered: len(state.buffer)})
+}
+
+func (state *engine) traceInput(packet frame, now time.Time, duplicates, stale, base uint64, buffered int, failure error) {
+	if !sessiontrace.PerformanceEnabled || (packet.kind != dataFrame && packet.kind != ackFrame) {
+		return
+	}
+	result := "new"
+	if packet.kind == ackFrame {
+		result = "accepted"
+		if packet.ack < base {
+			result = "old"
+		}
+	}
+	if failure != nil {
+		result = "rejected"
+	} else if state.stats.Stale != stale {
+		result = "stale"
+	} else if state.stats.Duplicates != duplicates {
+		result = "duplicate"
+	}
+	point := sessiontrace.TransportPoint{Kind: "receive", NS: sessiontrace.PerformanceTime(now), Wire: packet.traceWire(), Sequence: packet.seq, Bytes: len(packet.data), Result: result, Head: state.receive, Buffered: len(state.buffer)}
+	if packet.kind == dataFrame {
+		point.Mask = state.flow().ReceiveMask
+	}
+	if packet.kind == ackFrame {
+		point.Kind, point.Base, point.Mask, point.Before = "ack_input", packet.ack, packet.bits, base
+		point.Slots, point.Bytes = state.base-base, buffered-state.stats.BufferedBytes
+	}
+	state.trace.RecordTransport(point)
+	state.traceHead(now)
+}
