@@ -0,0 +1,49 @@
+package sessiontrace
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"sync/atomic"
+	"time"
+)
+
+var performanceCapture atomic.Uint64
+
+func PerformanceExport(tag string, value *TransportPerformance) ([][]byte, error) {
+	record := struct {
+		Event       string                `json:"event"`
+		SessionTag  string                `json:"session_tag"`
+		NodeNS      int64                 `json:"node_ns"`
+		Performance *TransportPerformance `json:"performance"`
+	}{"restricted_performance_v1", tag, PerformanceTime(time.Now()), value}
+	raw, err := json.Marshal(record)
+	if err != nil {
+		return nil, err
+	}
+	digest := sha256.Sum256(raw)
+	capture := performanceCapture.Add(1)
+	const size = 1800
+	parts := (len(raw) + size - 1) / size
+	output := make([][]byte, 0, parts)
+	for part := 0; part < parts; part++ {
+		chunk := struct {
+			Event      string `json:"event"`
+			Origin     string `json:"origin"`
+			SessionTag string `json:"session_tag"`
+			Capture    uint64 `json:"capture"`
+			Part       int    `json:"part"`
+			Parts      int    `json:"parts"`
+			Bytes      int    `json:"bytes"`
+			SHA256     string `json:"sha256"`
+			Data       string `json:"data"`
+		}{"restricted_performance_chunk_v1", transportOrigin, tag, capture, part, parts, len(raw), hex.EncodeToString(digest[:]), base64.StdEncoding.EncodeToString(raw[part*size : min(len(raw), (part+1)*size)])}
+		encoded, err := json.Marshal(chunk)
+		if err != nil {
+			return nil, err
+		}
+		output = append(output, append(encoded, '\n'))
+	}
+	return output, nil
+}
