@@ -0,0 +1,56 @@
+package telemost
+
+import (
+	"errors"
+	"net"
+	"time"
+
+	"github.com/pion/interceptor"
+	"github.com/pion/rtp"
+)
+
+type rtpTrackReader interface {
+	Read([]byte) (int, interceptor.Attributes, error)
+	SetReadDeadline(time.Time) error
+}
+
+func readReorderedRTP(track rtpTrackReader, reorder *reorderBuffer, closed <-chan struct{}, received, deliver func(*rtp.Packet)) error {
+	defer track.SetReadDeadline(time.Time{})
+	buffer := make([]byte, 65536)
+	var applied time.Time
+	initialized := false
+	for {
+		select {
+		case <-closed:
+			return ErrClosed
+		default:
+		}
+		reorder.expire(deliver)
+		due := reorder.deadline()
+		if !initialized || !due.Equal(applied) {
+			if err := track.SetReadDeadline(due); err != nil {
+				return err
+			}
+			applied, initialized = due, true
+		}
+		length, _, err := track.Read(buffer)
+		select {
+		case <-closed:
+			return ErrClosed
+		default:
+		}
+		if err != nil {
+			var timeout net.Error
+			if errors.As(err, &timeout) && timeout.Timeout() && !due.IsZero() && !reorder.now().Before(due) {
+				continue
+			}
+			return err
+		}
+		packet := &rtp.Packet{}
+		if packet.Unmarshal(buffer[:length]) != nil {
+			continue
+		}
+		received(packet)
+		reorder.push(packet, deliver)
+	}
+}
