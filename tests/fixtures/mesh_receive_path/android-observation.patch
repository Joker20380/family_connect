+func randomUint32() uint32 {
+	var b [4]byte
+	if _, err := rand.Read(b[:]); err != nil {
+		return uint32(time.Now().UnixNano())
+	}
+	v := binary.BigEndian.Uint32(b[:])
+	if v == 0 {
+		v = 1
+	}
+	return v
+}
