+package sessiontrace
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestPerformanceHistogramAndPrivacy(test *testing.T) {
+	var sizes SizeHistogram
+	for _, size := range []int{1, 512, 513, 1024, 2048, 4096, 8192, 16384, 16385} {
+		sizes.Add(size)
+	}
+	if sizes.Count != [7]uint64{2, 2, 1, 1, 1, 1, 1} {
+		test.Fatal(sizes)
+	}
+	recorder := New(strings.Repeat("1", 64), nil)
+	recorder.PerformancePlaintext(123)
+	for index := 0; index < 300; index++ {
+		recorder.Boundary(Boundary{Direction: "tx", Stage: "rtp_written", Result: "ok", DataKnown: true, DataSequence: uint64(index), AttemptKnown: true})
+	}
+	value := recorder.PerformanceSnapshot()
+	if !PerformanceEnabled {
+		if value != nil {
+			test.Fatal("disabled diagnostics allocated")
+		}
+		encoded, _ := json.Marshal(&Delivery{})
+		if strings.Contains(string(encoded), "performance") {
+			test.Fatal("default schema changed")
+		}
+		return
+	}
+	if value.Count != 300 || value.TLSPlaintextWrites.Bytes[0] != 123 || value.Points[299%128].Sequence != 299 {
+		test.Fatal("bounded boundary ring", value)
+	}
+	value.Points[0].Stage = "mutated"
+	if recorder.PerformanceSnapshot().Points[0].Stage == "mutated" {
+		test.Fatal("snapshot aliases recorder")
+	}
+}
+
+func BenchmarkPerformanceSnapshotJSON(bench *testing.B) {
+	if !PerformanceEnabled {
+		bench.Skip("diagnostic only")
+	}
+	value := &TransportPerformance{Window: &WindowPerformance{}, Mux: &MuxPerformance{Streams: make([]MuxStreamPerformance, 32)}, Media: &MediaPerformance{}}
+	for index := range value.Window.Events {
+		value.Window.Events[index] = WindowEvent{Kind: "cumulative_release", PayloadBytes: 16384, Sequence: uint64(index)}
+	}
+	for index := range value.Media.Points {
+		value.Media.Points[index] = MediaPoint{Stage: "carrier_written", Result: "ok", Sequence: uint64(index)}
+	}
+	raw, err := json.Marshal(value)
+	if err != nil {
+		bench.Fatal(err)
+	}
+	bench.ReportAllocs()
+	bench.ResetTimer()
+	for index := 0; index < bench.N; index++ {
+		if _, err := json.Marshal(value); err != nil {
+			bench.Fatal(err)
+		}
+	}
+	bench.ReportMetric(float64(len(raw)), "snapshot-B")
+}
