+package sessiontrace
+
+import "time"
+
+const ReceivePathLimit = 256
+const ReceiveIncidentLimit = 128
+
+type ReceivePoint struct {
+	Index        uint64 `json:"i"`
+	NS           int64  `json:"ns"`
+	Stage        string `json:"stage"`
+	Result       string `json:"result,omitempty"`
+	Direction    string `json:"direction"`
+	Sender       uint32 `json:"sender,omitempty"`
+	Message      uint32 `json:"message,omitempty"`
+	Fragment     uint32 `json:"fragment,omitempty"`
+	Total        uint32 `json:"total,omitempty"`
+	Mask         uint32 `json:"mask,omitempty"`
+	Sequence     uint64 `json:"seq,omitempty"`
+	Known        bool   `json:"known,omitempty"`
+	Attempt      uint32 `json:"attempt,omitempty"`
+	AttemptKnown bool   `json:"attempt_known,omitempty"`
+	Track        uint32 `json:"track,omitempty"`
+	Timestamp    uint32 `json:"ts,omitempty"`
+	First        uint16 `json:"first,omitempty"`
+	Last         uint16 `json:"last,omitempty"`
+	Packets      uint32 `json:"packets,omitempty"`
+	Next         uint16 `json:"next,omitempty"`
+	Buffered     int    `json:"buffered,omitempty"`
+	WaitNS       int64  `json:"wait_ns,omitempty"`
+}
+
+type ReceiveTrace struct {
+	Count         uint64         `json:"count"`
+	Overwritten   uint64         `json:"overwritten"`
+	Points        []ReceivePoint `json:"points"`
+	Incident      []ReceivePoint `json:"incident,omitempty"`
+	IncidentAt    uint64         `json:"incident_at,omitempty"`
+	LaterCapacity uint64         `json:"later_capacity"`
+}
+
+type receiveRing struct {
+	points        [ReceivePathLimit]ReceivePoint
+	count         uint64
+	incident      []ReceivePoint
+	incidentAt    uint64
+	laterCapacity uint64
+}
+
+func ReceiveBoundary(point Boundary) ReceivePoint {
+	return ReceivePoint{Stage: point.Stage, Result: point.Result, Direction: point.Direction,
+		Sender: point.Sender, Message: point.Message, Fragment: point.Fragment, Total: point.Total,
+		Sequence: point.DataSequence, Known: point.DataKnown, Attempt: point.Attempt, AttemptKnown: point.AttemptKnown,
+		Track: point.MediaTrack, Timestamp: point.Timestamp, First: point.FirstRTP, Last: point.LastRTP, Packets: point.Packets}
+}
+
+func (recorder *Recorder) RecordReceive(point ReceivePoint) {
+	if !PerformanceEnabled || recorder == nil {
+		return
+	}
+	recorder.mu.Lock()
+	defer recorder.mu.Unlock()
+	recorder.receivePoint(point)
+}
+
+func (recorder *Recorder) receivePoint(point ReceivePoint) {
+	if !PerformanceEnabled {
+		return
+	}
+	if recorder.receivePath == nil {
+		recorder.receivePath = &receiveRing{}
+	}
+	value := recorder.receivePath
+	value.count++
+	point.Index, point.NS = value.count, PerformanceTime(time.Now())
+	value.points[(value.count-1)%ReceivePathLimit] = point
+	if point.Result == "capacity" {
+		if value.incidentAt == 0 {
+			value.incidentAt = point.Index
+			for index := value.count - min(value.count, ReceiveIncidentLimit); index < value.count; index++ {
+				value.incident = append(value.incident, value.points[index%ReceivePathLimit])
+			}
+		} else {
+			value.laterCapacity++
+		}
+	}
+}
+
+func (recorder *Recorder) receiveSnapshotLocked() *ReceiveTrace {
+	value := recorder.receivePath
+	if value == nil {
+		return nil
+	}
+	dropped := value.count - min(value.count, ReceivePathLimit)
+	result := &ReceiveTrace{Count: value.count, Overwritten: dropped, IncidentAt: value.incidentAt,
+		LaterCapacity: value.laterCapacity, Incident: append([]ReceivePoint(nil), value.incident...)}
+	for index := dropped; index < value.count; index++ {
+		result.Points = append(result.Points, value.points[index%ReceivePathLimit])
+	}
+	return result
+}
