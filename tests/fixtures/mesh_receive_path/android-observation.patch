+
+type meshPerfPacket struct {
+	data          []byte
+	queued, ready time.Time
+}
+
+type meshPerfEndpoint struct {
+	ctx                                   context.Context
+	incoming, outgoing                    chan meshPerfPacket
+	delay                                 time.Duration
+	mu                                    sync.Mutex
+	next                                  time.Time
+	bytes, frames, segments, segmentBytes uint64
+	highWater                             int
+	residence, ackIntervals               []float64
+	lastACK                               time.Time
