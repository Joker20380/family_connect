+func TestPerformanceMuxByteExactCounters(test *testing.T) {
+	port := muxFixture(test, muxEcho)
+	ctx, client, _ := muxPair(test, port, 4, 4)
+	stream := muxOpen(test, ctx, client, port)
+	payload := bytes.Repeat([]byte{0x39}, 256<<10)
+	if err := exactMux(stream, payload); err != nil {
+		test.Fatal(err)
+	}
+	value := client.PerformanceSnapshot()
+	var queued, handed uint64
+	for _, record := range value.Streams {
+		if record.ID != stream.id {
+			continue
+		}
+		for _, count := range record.QueuedDATA.Bytes {
+			queued += count
+		}
+		for _, count := range record.HandedDATA.Bytes {
+			handed += count
+		}
+	}
+	for _, record := range value.Retired {
+		if record.ID != stream.id {
+			continue
+		}
+		for _, count := range record.QueuedDATA.Bytes {
+			queued += count
+		}
+		for _, count := range record.HandedDATA.Bytes {
+			handed += count
+		}
+	}
+	if queued != uint64(len(payload)) || handed != queued {
+		test.Fatalf("queued=%d handed=%d expected=%d", queued, handed, len(payload))
+	}
+}
+
+func TestPerformanceCreditAndQueueClocks(test *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	mux := &Mux{ctx: ctx, cancel: cancel, streams: make(map[uint32]*MuxStream), changed: make(chan struct{}), perf: &sessiontrace.MuxPerformance{}}
+	stream := mux.makeStreamLocked(1)
+	stream.opened, stream.sendCredit = true, 0
+	start := time.Now()
+	stream.perf.ReadyBytes, stream.perfAt = 4096, start
+	stream.send = []muxFrame{{kind: dataFrame, id: 1, payload: make([]byte, 1024)}}
+	value := stream.perfSnapshot(start.Add(80 * time.Millisecond))
+	if value.ZeroCreditReadyNS != uint64(80*time.Millisecond) || value.QueueReadyNS != value.ZeroCreditReadyNS || value.QueuedBytes != 1024 {
+		test.Fatal("overlapping wait accounting", value)
+	}
+	stream.perfAt = time.Now()
+	credit := make([]byte, 4)
+	binary.BigEndian.PutUint32(credit, 4096)
+	mux.dispatchLocked(muxFrame{kind: muxWindowUpdate, id: 1, payload: credit})
+	if stream.sendCredit != 4096 || stream.perf.CreditUpdates != 1 || stream.perf.CreditBytes != 4096 {
+		test.Fatal("credit update")
+	}
+	before := stream.perf.ZeroCreditReadyNS
+	value = stream.perfSnapshot(stream.perfAt.Add(80 * time.Millisecond))
+	if value.ZeroCreditReadyNS != before {
+		test.Fatal("positive-credit wait falsely attributed")
+	}
+	stream.perfAt = time.Now()
+	mux.removeLocked(1)
+	if mux.perf.RetiredCount != 1 || !mux.perf.Retired[0].Closed || mux.perf.Retired[0].CreditUpdates != 1 {
+		test.Fatal("retirement lost measurements")
+	}
+}
