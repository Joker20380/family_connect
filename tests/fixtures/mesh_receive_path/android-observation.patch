+package sessiontrace
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"os"
+	"strconv"
+	"time"
+)
+
+const TransportTraceLimit = 512
+
+type TransportPoint struct {
+	Index     uint64 `json:"i"`
+	NS        int64  `json:"ns"`
+	Kind      string `json:"kind"`
+	Wire      string `json:"wire,omitempty"`
+	Sequence  uint64 `json:"seq"`
+	Attempt   int    `json:"attempt,omitempty"`
+	Bytes     int    `json:"bytes,omitempty"`
+	Result    string `json:"result,omitempty"`
+	Reason    string `json:"reason,omitempty"`
+	FirstNS   int64  `json:"first_ns,omitempty"`
+	CarrierNS int64  `json:"carrier_ns,omitempty"`
+	Base      uint64 `json:"base,omitempty"`
+	Mask      uint32 `json:"mask,omitempty"`
+	Before    uint64 `json:"before,omitempty"`
+	Head      uint64 `json:"head,omitempty"`
+	Buffered  int    `json:"buffered,omitempty"`
+	Token     uint64 `json:"token,omitempty"`
+	Slots     uint64 `json:"slots,omitempty"`
+}
+
+type TransportTrace struct {
+	Receive      *ReceiveTrace    `json:"receive,omitempty"`
+	Origin       string           `json:"origin"`
+	OriginWallNS int64            `json:"origin_wall_ns"`
+	NowNS        int64            `json:"now_ns"`
+	Count        uint64           `json:"count"`
+	Overwritten  uint64           `json:"overwritten"`
+	Points       []TransportPoint `json:"points"`
+}
+
+type transportRing struct {
+	points [TransportTraceLimit]TransportPoint
+	count  uint64
+}
+
+var transportOrigin = WireTag([]byte(strconv.FormatInt(performanceOrigin.UnixNano(), 10)), []byte(strconv.Itoa(os.Getpid())))
+
+func WireTag(source, target []byte) string {
+	value := sha256.New()
+	value.Write([]byte("family-connect/performance-wire/v1\x00"))
+	value.Write(source)
+	value.Write(target)
+	return hex.EncodeToString(value.Sum(nil)[:16])
+}
+
+func (recorder *Recorder) RecordTransport(point TransportPoint) {
+	if !PerformanceEnabled || recorder == nil {
+		return
+	}
+	recorder.mu.Lock()
+	defer recorder.mu.Unlock()
+	recorder.transportPoint(point)
+}
+
+func (recorder *Recorder) transportPoint(point TransportPoint) {
+	if recorder.transport == nil {
+		recorder.transport = &transportRing{}
+	}
+	value := recorder.transport
+	value.count++
+	point.Index = value.count
+	if point.NS == 0 {
+		point.NS = PerformanceTime(time.Now())
+	}
+	value.points[(value.count-1)%TransportTraceLimit] = point
+}
+
+func (recorder *Recorder) TransportSnapshot() *TransportTrace {
+	if !PerformanceEnabled || recorder == nil {
+		return nil
+	}
+	recorder.mu.Lock()
+	defer recorder.mu.Unlock()
+	if recorder.transport == nil {
+		return nil
+	}
+	value := recorder.transport
+	dropped := value.count - min(value.count, TransportTraceLimit)
+	result := &TransportTrace{Origin: transportOrigin, OriginWallNS: performanceOrigin.UnixNano(), NowNS: PerformanceTime(time.Now()), Count: value.count, Overwritten: dropped, Points: make([]TransportPoint, 0, value.count-dropped)}
+	for index := dropped; index < value.count; index++ {
+		result.Points = append(result.Points, value.points[index%TransportTraceLimit])
+	}
+	result.Receive = recorder.receiveSnapshotLocked()
+	return result
+}
+
+type transportContextKey struct{}
+
+func WithTransportPoint(ctx context.Context, point TransportPoint) context.Context {
+	if !PerformanceEnabled {
+		return ctx
+	}
+	return context.WithValue(ctx, transportContextKey{}, point)
+}
+
+func (point *Boundary) CaptureTransport(ctx context.Context) {
+	if PerformanceEnabled {
+		point.transport, _ = ctx.Value(transportContextKey{}).(TransportPoint)
+	}
+}
+
+func (recorder *Recorder) transportBoundary(point Boundary) {
+	if !PerformanceEnabled || point.transport.Kind == "" || point.Total == 0 || point.Fragment+1 != point.Total {
+		return
+	}
+	if point.Stage != "carrier_queued" && point.Stage != "carrier_written" {
+		return
+	}
+	value := point.transport
+	value.Kind += "_" + point.Stage
+	value.Result = point.Result
+	value.NS = 0
+	recorder.transportPoint(value)
+}
