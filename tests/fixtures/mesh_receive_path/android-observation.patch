+
+func receivePacket(stage string, packet *rtp.Packet, track uint32) sessiontrace.ReceivePoint {
+	point := sessiontrace.ReceivePoint{Stage: stage, Direction: "rx", Track: track, Timestamp: packet.Timestamp,
+		First: packet.SequenceNumber, Last: packet.SequenceNumber, Packets: 1}
+	if !sessiontrace.PerformanceEnabled {
+		return point
+	}
+	var descriptor codecs.VP8Packet
+	if data, err := descriptor.Unmarshal(packet.Payload); err == nil && descriptor.S == 1 && descriptor.PID == 0 {
+		if fragment, valid := decodeVP8Frame(data); valid {
+			identity := fragmentBoundary(fragment)
+			point.Sender, point.Message, point.Fragment, point.Total = identity.Sender, identity.Message, identity.Fragment, identity.Total
+			point.Sequence, point.Known = identity.DataSequence, identity.DataKnown
+		}
+	}
+	return point
+}
+
+func (state *vp8FrameState) observeDiscard(reason string) {
+	if !sessiontrace.PerformanceEnabled {
+		return
+	}
+	point := sessiontrace.ReceivePoint{Stage: "frame_discard", Result: reason, Direction: "rx", Track: state.mediaTrack,
+		Timestamp: state.timestamp, Last: state.lastSeq}
+	if fragment, valid := decodeVP8Frame(state.frameBuf); valid {
+		identity := fragmentBoundary(fragment)
+		point.Sender, point.Message, point.Fragment, point.Total = identity.Sender, identity.Message, identity.Fragment, identity.Total
+		point.Sequence, point.Known = identity.DataSequence, identity.DataKnown
+	}
+	state.trace.RecordReceive(point)
+}
