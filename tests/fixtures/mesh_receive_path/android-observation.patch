+package reliablestream
+
+import (
+	"crypto/sha256"
+	"testing"
+	"time"
+)
+
+func TestPerformanceWireTranscript(test *testing.T) {
+	state := connectedEngines()[0]
+	digest := sha256.New()
+	for index := 0; index < 8; index++ {
+		packet, err := state.send(make([]byte, 384+index), state.started)
+		if err != nil {
+			test.Fatal(err)
+		}
+		digest.Write(encode(packet))
+	}
+	ack := frame{kind: ackFrame, source: state.remote, target: state.local, ack: 0, bits: 254}
+	output, err := state.input(ack, state.started.Add(80*time.Millisecond))
+	if err != nil {
+		test.Fatal(err)
+	}
+	for _, packet := range output {
+		digest.Write(encode(packet))
+	}
+	output, err = state.tick(state.started.Add(300 * time.Millisecond))
+	if err != nil {
+		test.Fatal(err)
+	}
+	for _, packet := range output {
+		digest.Write(encode(packet))
+	}
+	ack.bits = 255
+	state.input(ack, state.started.Add(320*time.Millisecond))
+	ack.ack, ack.bits = 8, 0
+	state.input(ack, state.started.Add(400*time.Millisecond))
+	packet, err := state.send(make([]byte, 16384), state.started.Add(410*time.Millisecond))
+	if err != nil {
+		test.Fatal(err)
+	}
+	digest.Write(encode(packet))
+	test.Logf("WIRE_SHA256=%x", digest.Sum(nil))
+}
+
+func BenchmarkPerformanceWindow384(bench *testing.B) { benchmarkPerformanceWindow(bench, 384) }
+func BenchmarkPerformanceWindow16K(bench *testing.B) { benchmarkPerformanceWindow(bench, 16384) }
+
+func benchmarkPerformanceWindow(bench *testing.B, size int) {
+	state := connectedEngines()[0]
+	payload := make([]byte, size)
+	bench.ReportAllocs()
+	bench.SetBytes(int64(size))
+	bench.ResetTimer()
+	for index := 0; index < bench.N; index++ {
+		now := state.started.Add(time.Duration(index) * time.Millisecond)
+		packet, err := state.send(payload, now)
+		if err != nil {
+			bench.Fatal(err)
+		}
+		_, err = state.input(frame{kind: ackFrame, source: state.remote, target: state.local, ack: packet.seq + 1}, now.Add(80*time.Microsecond))
+		if err != nil {
+			bench.Fatal(err)
+		}
+	}
+}
