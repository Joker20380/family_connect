+func TestTransportTraceScenarios(test *testing.T) {
+	config := DefaultConfig()
+	config.RTO = 10 * time.Millisecond
+	now := time.Now()
+	sender := newEngine(config, epoch{1}, now)
+	receiver := newEngine(config, epoch{2}, now)
+	sender.remote, receiver.remote = receiver.local, sender.local
+	sender.remoteWindow, receiver.remoteWindow = config.ReceiveWindow, config.ReceiveWindow
+	sender.remoteSize, receiver.remoteSize = config.Payload, config.Payload
+	sender.trace, receiver.trace = sessiontrace.New(strings.Repeat("a", 64), nil), sessiontrace.New(strings.Repeat("a", 64), nil)
+	transmit := func(state *engine, packet frame, delay bool) []frame {
+		test.Helper()
+		origin := sender
+		if state == sender {
+			origin = receiver
+		}
+		point := sessiontrace.TransportPoint{Kind: "data", Wire: packet.traceWire(), Sequence: packet.seq, Bytes: len(packet.data)}
+		if packet.kind == ackFrame {
+			point = sessiontrace.ACKPoint(packet.observation, packet.ack, packet.bits)
+		}
+		ctx := sessiontrace.WithTransportPoint(context.Background(), point)
+		boundary := sessiontrace.Boundary{Direction: "tx", Stage: "carrier_queued", Result: "ok", Total: 1}
+		boundary.CaptureTransport(ctx)
+		origin.trace.Boundary(boundary)
+		if delay {
+			time.Sleep(6 * time.Millisecond)
+		}
+		boundary.Stage = "carrier_written"
+		origin.trace.Boundary(boundary)
+		identity := sessiontrace.NewReceiveIdentity(sessiontrace.Boundary{MessageKnown: true})
+		decoded, err := decode(encode(packet))
+		if err != nil {
+			test.Fatal(err)
+		}
+		kind := "data_decode"
+		if decoded.kind == ackFrame {
+			kind = "ack_decode"
+		}
+		state.trace.RecordTransport(sessiontrace.TransportPoint{Kind: kind, Wire: decoded.traceWire(), Sequence: decoded.seq, Bytes: len(decoded.data), Base: decoded.ack, Mask: decoded.bits, CarrierNS: sessiontrace.ReceiveCompletedNS(identity), Result: "ok"})
+		output, err := state.input(decoded, time.Now())
+		if err != nil {
+			test.Fatal(err)
+		}
+		return output
+	}
+	first, _ := sender.send([]byte("first"), time.Now())
+	second, _ := sender.send([]byte("second"), time.Now())
+	transmit(receiver, second, false)
+	if len(receiver.buffer[receiver.receive]) != 0 {
+		test.Fatal("out of order exposed")
+	}
+	time.Sleep(12 * time.Millisecond)
+	retries, err := sender.tick(time.Now())
+	if err != nil {
+		test.Fatal(err)
+	}
+	found := false
+	for _, retry := range retries {
+		if retry.kind == dataFrame && retry.seq == first.seq {
+			transmit(receiver, retry, false)
+			found = true
+		}
+	}
+	if !found {
+		test.Fatal("missing original loss retry")
+	}
+	time.Sleep(5 * time.Millisecond)
+	data, _ := receiver.consume()
+	if !bytes.Equal(data, first.data) {
+		test.Fatal("first bytes differ")
+	}
+	data, ack := receiver.consume()
+	if !bytes.Equal(data, second.data) {
+		test.Fatal("second bytes differ")
+	}
+	transmit(sender, ack, false)
+	lostACK, _ := sender.send([]byte("consumed once"), time.Now())
+	transmit(receiver, lostACK, false)
+	data, _ = receiver.consume()
+	if !bytes.Equal(data, lostACK.data) {
+		test.Fatal("lost ack bytes differ")
+	}
+	time.Sleep(12 * time.Millisecond)
+	retries, err = sender.tick(time.Now())
+	if err != nil {
+		test.Fatal(err)
+	}
+	for _, retry := range retries {
+		if retry.kind == dataFrame && retry.seq == lostACK.seq {
+			acks := transmit(receiver, retry, false)
+			if len(acks) != 1 {
+				test.Fatal("duplicate should ACK")
+			}
+			transmit(sender, acks[0], true)
+		}
+	}
+	if sender.base != 3 || len(sender.sent) != 0 || receiver.receive != 3 {
+		test.Fatal("ACK did not free base")
+	}
+	normal, _ := sender.send([]byte("control"), time.Now())
+	transmit(receiver, normal, false)
+	_, ack = receiver.consume()
+	transmit(sender, ack, false)
+	stale := normal
+	stale.source = epoch{9}
+	receiver.input(stale, time.Now())
+	bad := normal
+	bad.seq = ^uint64(0)
+	if _, err = receiver.input(bad, time.Now()); err != ErrProtocol {
+		test.Fatal("invalid DATA accepted")
+	}
+	badACK := ack
+	badACK.ack = sender.next + 1
+	if _, err = sender.input(badACK, time.Now()); err != ErrProtocol {
+		test.Fatal("invalid ACK accepted")
+	}
+	duplicateConsumes := 0
+	for _, point := range receiver.trace.TransportSnapshot().Points {
+		if point.Kind == "consume" && point.Sequence == 2 {
+			duplicateConsumes++
+		}
+	}
+	if duplicateConsumes != 1 {
+		test.Fatal("duplicate consumed", duplicateConsumes)
+	}
+	refresh, _ := receiver.tick(time.Now().Add(config.RTO))
+	if len(refresh) == 0 {
+		test.Fatal("missing refresh")
+	}
+	for _, point := range receiver.trace.TransportSnapshot().Points {
+		if point.NS < 0 {
+			test.Fatal("nonmonotonic origin")
+		}
+	}
+	newSession := newEngine(config, epoch{3}, time.Now())
+	newSession.remote, newSession.remoteWindow, newSession.remoteSize = epoch{4}, config.ReceiveWindow, config.Payload
+	newSession.trace = sender.trace
+	newSession.send([]byte("new session zero"), time.Now())
+	if newSession.packet(dataFrame).traceWire() == sender.packet(dataFrame).traceWire() {
+		test.Fatal("epoch collision")
+	}
+	output := os.Getenv("MESH_TRACE_OUTPUT")
+	if output == "" {
+		return
+	}
+	if err = os.MkdirAll(output, 0700); err != nil {
+		test.Fatal(err)
+	}
+	for label, state := range map[string]*engine{"nl": sender, "android": receiver} {
+		value := &sessiontrace.TransportPerformance{Trace: state.trace.TransportSnapshot(), Window: state.perfSnapshot(time.Now())}
+		chunks, err := sessiontrace.PerformanceExport(state.trace.PerformanceTag(), value)
+		if err != nil {
+			test.Fatal(err)
+		}
+		if err = os.WriteFile(filepath.Join(output, label+"-chunks.jsonl"), bytes.Join(chunks, nil), 0600); err != nil {
+			test.Fatal(err)
+		}
+		if label == "android" {
+			raw, _ := json.Marshal(map[string]any{"state": 2, "packet": map[string]any{"diagnostic": map[string]any{"session_tag": state.trace.PerformanceTag(), "restricted_performance_v1": value}}})
+			if err = os.WriteFile(filepath.Join(output, "native-snapshot.json"), raw, 0600); err != nil {
+				test.Fatal(err)
+			}
+		}
+	}
+}
+
+func TestTransportTraceOverflow(test *testing.T) {
+	recorder := sessiontrace.New(strings.Repeat("b", 64), nil)
+	for index := 0; index < 700; index++ {
+		recorder.RecordTransport(sessiontrace.TransportPoint{Kind: "submission", Sequence: uint64(index)})
+	}
+	value := recorder.TransportSnapshot()
+	if value.Count != 700 || value.Overwritten != 188 || len(value.Points) != 512 || value.Points[0].Index != 189 {
+		test.Fatal("bad ring bounds")
+	}
+	chunks, err := sessiontrace.PerformanceExport(recorder.PerformanceTag(), &sessiontrace.TransportPerformance{Trace: value})
+	if err != nil || len(chunks) < 2 {
+		test.Fatal("missing split export", err)
+	}
+	for _, chunk := range chunks {
+		if len(chunk) > 3200 {
+			test.Fatal("oversized chunk")
+		}
+	}
+}
