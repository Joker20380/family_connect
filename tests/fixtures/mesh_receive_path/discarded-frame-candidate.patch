+func (r *reassembler) discardFrame(frame []byte) {
+	data, valid := decodeVP8Frame(frame)
+	if !valid {
+		return
+	}
+	sender, message := binary.BigEndian.Uint32(data), binary.BigEndian.Uint32(data[4:])
+	sequence, total := binary.BigEndian.Uint32(data[8:]), binary.BigEndian.Uint32(data[12:])
+	length, checksum := binary.BigEndian.Uint32(data[16:]), binary.BigEndian.Uint32(data[20:])
+	if sender == r.selfID || length > MaxMessageSize || total == 0 || sequence >= total || total != max(uint32(1), (length+maxFragmentPayload-1)/maxFragmentPayload) {
+		return
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.pruneLocked(r.now())
+	key := [2]uint32{sender, message}
+	if _, exists := r.recent[key]; exists {
+		return
+	}
+	builder := r.builds[key]
+	point := fragmentBoundary(data)
+	point.Stage, point.Direction, point.Result = "carrier_message_completed", "rx", "frame_discard"
+	deadline := r.now().Add(reassemblyTimeout)
+	if builder != nil {
+		if builder.total != total || builder.length != length || builder.checksum != checksum {
+			return
+		}
+		if _, received := builder.received[sequence]; received {
+			return
+		}
+		deadline = builder.deadline
+		point.DataKnown, point.DataSequence = builder.diagnostic.DataKnown, builder.diagnostic.DataSequence
+	} else if len(r.recent)+len(r.builds) >= maxRecentMessages {
+		return
+	}
+	delete(r.builds, key)
+	r.recent[key] = deadline
+	r.trace.Boundary(point)
 }
 
