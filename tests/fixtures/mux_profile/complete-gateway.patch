+package tcpforward
+
+import (
+	"github.com/Joker20380/family_connect/carrier/sessiontrace"
+	"time"
+)
+
+func (stream *MuxStream) perfAdvance(now time.Time) {
+	if !sessiontrace.PerformanceEnabled {
+		return
+	}
+	if stream.perfAt.IsZero() {
+		stream.perfAt = now
+	}
+	elapsed := uint64(max(0, now.Sub(stream.perfAt)))
+	if stream.perf.ReadyBytes > 0 && stream.terminal == nil && !stream.localFIN {
+		if stream.sendCredit == 0 {
+			stream.perf.ZeroCreditReadyNS += elapsed
+		}
+		if len(stream.send) > 0 {
+			stream.perf.QueueReadyNS += elapsed
+		}
+	}
+	stream.perfAt = now
+}
+
+func (stream *MuxStream) perfSnapshot(now time.Time) sessiontrace.MuxStreamPerformance {
+	stream.perfAdvance(now)
+	value := stream.perf
+	value.ID, value.Credit = stream.id, stream.sendCredit
+	value.CreditPending, value.ReceiveBuffered = stream.creditPending, stream.used
+	value.QueuedBytes = 0
+	for _, frame := range stream.send {
+		if frame.kind == dataFrame {
+			value.QueuedBytes += len(frame.payload)
+		}
+	}
+	return value
+}
+
+func (mux *Mux) PerformanceSnapshot() *sessiontrace.MuxPerformance {
+	if !sessiontrace.PerformanceEnabled {
+		return nil
+	}
+	mux.mu.Lock()
+	defer mux.mu.Unlock()
+	if mux.perf == nil {
+		mux.perf = &sessiontrace.MuxPerformance{}
+	}
+	value := *mux.perf
+	value.Profile, value.Window = mux.stats.Profile, mux.stats.Window
+	value.ProtocolErrors = mux.stats.ProtocolErrors
+	value.ActiveStreams = mux.stats.ActiveStreams
+	value.RetainedBytes, value.RetainedHighWater = mux.stats.RetainedBytes, mux.stats.RetainedHighWater
+	now := time.Now()
+	for _, id := range mux.order {
+		if stream := mux.streams[id]; stream != nil {
+			value.Streams = append(value.Streams, stream.perfSnapshot(now))
+		}
+	}
+	return &value
+}
