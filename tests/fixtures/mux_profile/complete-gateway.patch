+func TestPerformanceSACKRetentionAndClock(test *testing.T) {
+	state := connectedEngines()[0]
+	start := state.started
+	for index := 0; index < 8; index++ {
+		if _, err := state.send(make([]byte, 384), start); err != nil {
+			test.Fatal(err)
+		}
+	}
+	state.perf.Ready = true
+	ack := frame{kind: ackFrame, source: state.remote, target: state.local, ack: 0, bits: 254}
+	if _, err := state.input(ack, start.Add(80*time.Millisecond)); err != nil {
+		test.Fatal(err)
+	}
+	value := state.perfSnapshot(start.Add(100 * time.Millisecond))
+	state.perfAdvance(start.Add(90 * time.Millisecond))
+	if state.perfSnapshot(start.Add(100*time.Millisecond)).FullNS != value.FullNS {
+		test.Fatal("stale tick double-counted elapsed time")
+	}
+	if value.SlotSpan != 8 || value.EffectiveWindow != 8 || value.RetainedBytes != 3072 || value.SACKedBytes != 2688 || value.UnconfirmedBytes != 384 || value.HeadSACKed || value.FullNS != uint64(100*time.Millisecond) || value.WindowOnlyBlockedNS != value.FullNS {
+		test.Fatalf("incorrect retention/clock: %+v", value)
+	}
+	packets, err := state.tick(start.Add(300 * time.Millisecond))
+	if err != nil {
+		test.Fatal(err)
+	}
+	retries := 0
+	for _, packet := range packets {
+		if packet.kind == dataFrame {
+			retries++
+		}
+	}
+	if retries != 1 || state.perf.RetryDATA.Bytes[0] != 384 || state.perf.NewDATA.Bytes[0] != 3072 {
+		test.Fatal("retry counted as new data")
+	}
+	ack.bits = 255
+	state.input(ack, start.Add(320*time.Millisecond))
+	state.input(ack, start.Add(330*time.Millisecond))
+	value = state.perfSnapshot(start.Add(340 * time.Millisecond))
+	if value.SACKedBytes != value.RetainedBytes || !value.HeadSACKed || value.SlotSpan != 8 || value.FirstACKRecovery.Count[5] != 1 {
+		test.Fatal("SACKed head must retain position; recovery is not RTT")
+	}
+	ack.ack, ack.bits = 8, 0
+	state.input(ack, start.Add(400*time.Millisecond))
+	value = state.perfSnapshot(start.Add(500 * time.Millisecond))
+	if value.HeadSACKedBlockedNS != uint64(80*time.Millisecond) || value.HeadUnconfirmedLaterSACKedBlockedNS != uint64(240*time.Millisecond) {
+		test.Fatal("head-blocked time classification")
+	}
+	if value.SlotSpan != 0 || value.RetainedBytes != 0 || value.ReleasedBytes != 3072 || value.ReleasedBlocks != 8 || value.FullNS != uint64(400*time.Millisecond) {
+		test.Fatal("release accounting", value)
+	}
+	value.Events[0].Kind = "mutated"
+	if state.perf.Events[0].Kind == "mutated" {
+		test.Fatal("snapshot aliases storage")
+	}
+	for index := 0; index < 1000; index++ {
+		state.perfEvent(uint64(index), "test", 384, 0, start)
+	}
+	if len(state.perf.Events) != 128 || state.perf.EventCount < 1000 {
+		test.Fatal("ring bound")
+	}
+}
