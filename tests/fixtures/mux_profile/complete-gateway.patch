+			retired = append(retired, stream)
+		}
+	}
+	mux := struct {
+		*sessiontrace.MuxPerformance
+		Retired []sessiontrace.MuxStreamPerformance
+	}{value.Mux, retired}
+	compact := struct {
+		*sessiontrace.TransportPerformance
+		Window any
+		Mux    any
+		Media  any `json:"Media,omitempty"`
+	}{TransportPerformance: value, Window: window, Mux: mux}
+	record := struct {
+		Event       string `json:"event"`
+		SessionTag  string `json:"session_tag"`
+		NodeNS      int64  `json:"node_ns"`
+		Performance any    `json:"performance"`
+	}{"restricted_performance_v1", trace.PerformanceTag(), sessiontrace.PerformanceTime(time.Now()), compact}
+	_ = json.NewEncoder(os.Stdout).Encode(record)
+}
