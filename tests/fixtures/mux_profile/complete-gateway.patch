+package reliablestream
+
+import (
+	"github.com/Joker20380/family_connect/carrier/sessiontrace"
+	"time"
+)
+
+func (state *engine) perfAdvance(now time.Time) {
+	if !sessiontrace.PerformanceEnabled || state.perf.Terminal {
+		return
+	}
+	if state.perfAt.IsZero() {
+		state.perfAt = now
+	}
+	if now.Before(state.perfAt) {
+		return
+	}
+	elapsed := uint64(max(0, now.Sub(state.perfAt)))
+	if state.remote != (epoch{}) && !state.writable() {
+		state.perf.FullNS += elapsed
+		if state.perf.Ready {
+			state.perf.ReadyFullNS += elapsed
+			if !state.perf.LocalWriterBusy && state.perf.LocalQueuedFrames == 0 {
+				state.perf.WindowOnlyBlockedNS += elapsed
+				if head := state.sent[state.base]; head != nil {
+					if head.sacked {
+						state.perf.HeadSACKedBlockedNS += elapsed
+					} else {
+						for sequence, later := range state.sent {
+							if sequence != state.base && later.sacked {
+								state.perf.HeadUnconfirmedLaterSACKedBlockedNS += elapsed
+								break
+							}
+						}
+					}
+				}
+			}
+		}
+	}
+	state.perfAt = now
+}
+
+func (state *engine) perfEvent(sequence uint64, kind string, size, retries int, now time.Time) {
+	if !sessiontrace.PerformanceEnabled {
+		return
+	}
+	state.perf.Events[state.perf.EventCount%128] = sessiontrace.WindowEvent{Sequence: sequence, Kind: kind, PayloadBytes: size, Retries: retries, SinceStartNS: now.Sub(state.started).Nanoseconds(), NodeNS: sessiontrace.PerformanceTime(now)}
+	state.perf.EventCount++
+}
+
+func (state *engine) perfACK(sequence uint64, block *pending, release bool, now time.Time) {
+	if !sessiontrace.PerformanceEnabled {
+		return
+	}
+	if !block.sacked {
+		if block.retries == 0 {
+			state.perf.FirstACKNoRetry.Add(now.Sub(block.first))
+		} else {
+			state.perf.FirstACKRecovery.Add(now.Sub(block.first))
+		}
+		state.perfEvent(sequence, "first_ack", len(block.data), block.retries, now)
+	}
+	if release {
+		state.perf.ReleasedBlocks++
+		state.perf.ReleasedBytes += uint64(len(block.data))
+		if block.retries == 0 {
+			state.perf.ReleaseNoRetry.Add(now.Sub(block.first))
+		} else {
+			state.perf.ReleaseRecovery.Add(now.Sub(block.first))
+		}
+		state.perfEvent(sequence, "cumulative_release", len(block.data), block.retries, now)
+	}
+}
+
+func (state *engine) perfSnapshot(now time.Time) *sessiontrace.WindowPerformance {
+	if !sessiontrace.PerformanceEnabled {
+		return nil
+	}
+	state.perfAdvance(now)
+	value := *state.perf
+	value.EffectiveWindow = min(state.config.SendWindow, state.remoteWindow)
+	value.SlotSpan = state.next - state.base
+	for _, block := range state.sent {
+		if block.perfEnqueued {
+			value.EnqueuedRetainedBytes += uint64(len(block.data))
+			value.EnqueuedRetainedBlocks++
+		}
+		value.RetainedBytes += uint64(len(block.data))
+		value.RetainedBlocks++
+		if block.sacked {
+			value.SACKedBytes += uint64(len(block.data))
+			value.SACKedBlocks++
+		} else {
+			value.UnconfirmedBytes += uint64(len(block.data))
+			value.UnconfirmedBlocks++
+		}
+	}
+	if head := state.sent[state.base]; head != nil {
+		value.HeadPresent, value.HeadSACKed, value.HeadRetries = true, head.sacked, head.retries
+		value.HeadAgeNS = now.Sub(head.first).Nanoseconds()
+	}
+	return &value
+}
