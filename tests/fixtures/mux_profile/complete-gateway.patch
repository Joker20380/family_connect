+func recordPerformance(trace *sessiontrace.Recorder, value *sessiontrace.TransportPerformance) {
+	window := struct {
+		*sessiontrace.WindowPerformance
+		Events []sessiontrace.WindowEvent `json:"Events,omitempty"`
+	}{WindowPerformance: value.Window}
+	retired := []sessiontrace.MuxStreamPerformance{}
+	for _, stream := range value.Mux.Retired {
