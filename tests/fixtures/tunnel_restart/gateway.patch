+package main
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/Joker20380/family_connect/carrier/bootstrap"
+	"github.com/Joker20380/family_connect/carrier/familysession"
+	"github.com/Joker20380/family_connect/carrier/roombroker"
+	"github.com/Joker20380/family_connect/carrier/telemost"
+)
+
+func signal1011() *bootstrap.SeedFailure {
+	return &bootstrap.SeedFailure{Stage: "SEED_READ", CloseSource: "SIGNAL_READ", Cause: errors.New("fixture"),
+		SignalingRead: telemost.SignalingReadFailure{Kind: "WS_CLOSE", CloseCode: 1011, ContextState: "ACTIVE"}}
+}
+
+func TestSeedRecoveryClassification(test *testing.T) {
+	for _, kind := range []string{"1011", "1000", "1008", "1006", "unknown", "closed", "cancelled", "parent", "stage", "source", "auth", "publication", "connect"} {
+		test.Run(kind, func(test *testing.T) {
+			failure := signal1011()
+			err := roombroker.Code("seed_closed")
+			switch kind {
+			case "1000", "1008", "1006":
+				fmt.Sscan(kind, &failure.SignalingRead.CloseCode)
+			case "unknown":
+				failure.SignalingRead.Kind = "UNKNOWN"
+			case "closed":
+				failure.SignalingRead.CarrierClosed = true
+			case "cancelled":
+				failure.SignalingRead.ContextState = "CANCELLED"
+			case "parent":
+				failure.ParentError = context.Canceled
+			case "stage":
+				failure.Stage = "SEED_CREATE"
+			case "source":
+				failure.CloseSource = "SUBSCRIBER_DISCONNECTED"
+			case "auth":
+				err = "authorization_changed"
+			case "publication":
+				err = "seed_publication_failed"
+			case "connect":
+				err = "seed_not_ready"
+			}
+			if recoverableSeed(err, failure) != (kind == "1011") {
+				test.Fatal("classification", kind)
+			}
+		})
+	}
+}
+
+func TestSeedRecoveryBudgetAndCancellation(test *testing.T) {
+	for _, cancelAt := range []int{-1, 0, 1, 2, 3} {
+		test.Run(fmt.Sprint(cancelAt), func(test *testing.T) {
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			if cancelAt == 0 {
+				cancel()
+			}
+			runs, waits, reports := 0, 0, 0
+			err := recoverSeed(ctx, func() (error, *bootstrap.SeedFailure) {
+				runs++
+				return roombroker.Code("seed_closed"), signal1011()
+			}, func(bootstrap.SeedFailure) { reports++ }, func(string) {}, func(ctx context.Context) error {
+				waits++
+				if waits == cancelAt {
+					cancel()
+				}
+				return ctx.Err()
+			})
+			if cancelAt < 0 {
+				if runs != 4 || waits != 3 || reports != 1 || err != roombroker.Code("seed_closed") {
+					test.Fatal(runs, waits, reports, err)
+				}
+			} else if runs != cancelAt || reports != 0 || !errors.Is(err, context.Canceled) {
+				test.Fatal(runs, reports, err)
+			}
+		})
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if !errors.Is(waitSeedRetry(ctx), context.Canceled) {
+		test.Fatal("wait ignores cancellation")
+	}
+}
+
+type recoveryProvider struct{ calls atomic.Int32 }
+
+func (provider *recoveryProvider) CreateRoom(context.Context) (roombroker.Room, error) {
+	index := provider.calls.Add(1)
+	return roombroker.Room{ID: fmt.Sprint(index), JoinURL: fmt.Sprintf("https://telemost.yandex.ru/j/recovery-%d", index)}, nil
+}
+
+func TestSeedRecoveryPreservesParentAndReleasesEveryGeneration(test *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
+	defer cancel()
+	provider := &recoveryProvider{}
+	manager := &bootstrap.SeedManager{RotateAfter: 30 * time.Minute}
+	var endpoints []*signalingMatrixEndpoint
+	var published []bootstrap.Directory
+	var observed []bootstrap.SeedFailure
+	manager.Publish = func(directory bootstrap.Directory) error { published = append(published, directory); return nil }
+	waits := 0
+	err := recoverSeed(ctx, func() (error, *bootstrap.SeedFailure) {
+		var first *bootstrap.SeedFailure
+		manager.Observe = func(value bootstrap.SeedFailure) {
+			if first == nil {
+				first = &value
+			}
+		}
+		result := manager.Run(ctx, provider, func(context.Context, context.Context, roombroker.Room) (familysession.PacketEndpoint, error) {
+			endpoint := &signalingMatrixEndpoint{matrixEndpoint: matrixEndpoint{cause: errors.New("remote close"), source: "SIGNAL_READ"}, read: signal1011().SignalingRead}
+			endpoints = append(endpoints, endpoint)
+			return endpoint, nil
+		}, strings.Repeat("a", 32), strings.Repeat("b", 32), time.Hour, func(context.Context, familysession.PacketEndpoint) { test.Error("unexpected exchange") })
+		return result, first
+	}, func(value bootstrap.SeedFailure) { observed = append(observed, value) }, func(string) {}, func(ctx context.Context) error {
+		waits++
+		if ctx.Err() != nil {
+			test.Fatal("independent dedicated parent cancelled")
+		}
+		for _, endpoint := range endpoints {
+			if endpoint.closed.Load() == 0 {
+				test.Fatal("old generation leaked")
+			}
+		}
+		return nil
+	})
+	if err != roombroker.Code("seed_closed") || len(published) != 4 || waits != 3 || len(observed) != 1 || ctx.Err() != nil {
+		test.Fatal(err, len(published), waits, len(observed), ctx.Err())
+	}
+	deadline, _ := ctx.Deadline()
+	for index, directory := range published {
+		if directory.ExpiresAt.After(deadline) || directory.Version != 1 {
+			test.Fatal("lifetime or wire changed")
+		}
+		if index > 0 && directory.Seeds[0].JoinURL == published[index-1].Seeds[0].JoinURL {
+			test.Fatal("reused closed seed")
+		}
+	}
+}
