+package main
+
+import (
+	"context"
+	"time"
+
+	"github.com/Joker20380/family_connect/carrier/bootstrap"
+	"github.com/Joker20380/family_connect/carrier/roombroker"
+)
+
+const seedRecoveryAttempts = 3
+const seedRecoveryDelay = 30 * time.Second
+
+func recoverableSeed(err error, failure *bootstrap.SeedFailure) bool {
+	if err != roombroker.Code("seed_closed") || failure == nil || failure.ParentError != nil || failure.Stage != "SEED_READ" || failure.CloseSource != "SIGNAL_READ" {
+		return false
+	}
+	read := failure.SignalingRead
+	return read.Kind == "WS_CLOSE" && read.CloseCode == 1011 && read.ContextState == "ACTIVE" && !read.CarrierClosed
+}
+
+func waitSeedRetry(ctx context.Context) error {
+	timer := time.NewTimer(seedRecoveryDelay)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-timer.C:
+		return ctx.Err()
+	}
+}
+
+func recoverSeed(ctx context.Context, run func() (error, *bootstrap.SeedFailure), observe func(bootstrap.SeedFailure), event func(string), wait func(context.Context) error) error {
+	for attempt := 0; ; attempt++ {
+		if ctx.Err() != nil {
+			return ctx.Err()
+		}
+		err, failure := run()
+		if ctx.Err() != nil || attempt >= seedRecoveryAttempts || !recoverableSeed(err, failure) {
+			if failure != nil {
+				observe(*failure)
+			}
+			return err
+		}
+		event("bootstrap_seed_signal_1011_retry")
+		if err := wait(ctx); err != nil {
+			return err
+		}
+	}
+}
