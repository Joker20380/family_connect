+	stats := left.Stats()
+	if stats.Terminal != "remote_reset" || !stats.Performance.Terminal || stats.Performance.Ready || stats.Performance.RetainedBytes != 0 || stats.Performance.NewDATA.Bytes[0] != 3 {
+		test.Fatal("reset counters", stats.Terminal)
+	}
+}
