+		Event       string                             `json:"event"`
+		SessionTag  string                             `json:"session_tag"`
+		NodeNS      int64                              `json:"node_ns"`
+		Performance *sessiontrace.TransportPerformance `json:"performance"`
+	}{"restricted_performance_v1", trace.PerformanceTag(), sessiontrace.PerformanceTime(time.Now()), value}
+	_ = json.NewEncoder(os.Stdout).Encode(record)
+}
