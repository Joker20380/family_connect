+package sessiontrace
+
+import "time"
+
+type SizeHistogram struct {
+	Count [7]uint64
+	Bytes [7]uint64
+}
+
+func (histogram *SizeHistogram) Add(size int) {
+	index := 0
+	for index < 6 && size > [...]int{512, 1024, 2048, 4096, 8192, 16384}[index] {
+		index++
+	}
+	histogram.Count[index]++
+	histogram.Bytes[index] += uint64(size)
+}
+
+type DurationHistogram struct {
+	Count   [9]uint64
+	TotalNS uint64
+	MaxNS   uint64
+}
+
+func (histogram *DurationHistogram) Add(elapsed time.Duration) {
+	if elapsed < 0 {
+		return
+	}
+	index := 0
+	for index < 8 && elapsed > [...]time.Duration{time.Millisecond, 5 * time.Millisecond, 20 * time.Millisecond, 80 * time.Millisecond, 200 * time.Millisecond, 500 * time.Millisecond, time.Second, 5 * time.Second}[index] {
+		index++
+	}
+	histogram.Count[index]++
+	histogram.TotalNS += uint64(elapsed)
+	histogram.MaxNS = max(histogram.MaxNS, uint64(elapsed))
+}
+
+type WindowEvent struct {
+	NodeNS       int64
+	Sequence     uint64
+	Kind         string
+	SinceStartNS int64
+	PayloadBytes int
+	Retries      int
+}
+
+type WindowPerformance struct {
+	CarrierAcceptedDATA                 SizeHistogram
+	EnqueuedRetainedBytes               uint64
+	EnqueuedRetainedBlocks              int
+	NewDATA                             SizeHistogram
+	RetryDATA                           SizeHistogram
+	SubmissionToEnqueue                 DurationHistogram
+	FirstACKNoRetry                     DurationHistogram
+	FirstACKRecovery                    DurationHistogram
+	ReleaseNoRetry                      DurationHistogram
+	ReleaseRecovery                     DurationHistogram
+	ReleasedBytes                       uint64
+	ReleasedBlocks                      uint64
+	FullNS                              uint64
+	ReadyFullNS                         uint64
+	WindowOnlyBlockedNS                 uint64
+	HeadSACKedBlockedNS                 uint64
+	HeadUnconfirmedLaterSACKedBlockedNS uint64
+	Ready                               bool
+	LocalWriterBusy                     bool
+	LocalQueuedFrames                   int
+	LocalQueuedBytes                    int
+	EffectiveWindow                     int
+	SlotSpan                            uint64
+	RetainedBytes                       uint64
+	SACKedBytes                         uint64
+	UnconfirmedBytes                    uint64
+	RetainedBlocks                      int
+	SACKedBlocks                        int
+	UnconfirmedBlocks                   int
+	HeadAgeNS                           int64
+	HeadSACKed                          bool
+	HeadRetries                         int
+	HeadPresent                         bool
+	Events                              [128]WindowEvent
+	EventCount                          uint64
+	Terminal                            bool
+}
+
+type MuxStreamPerformance struct {
+	ID                uint32
+	Credit            int
+	QueuedBytes       int
+	ReadyBytes        int
+	QueuedDATA        SizeHistogram
+	HandedDATA        SizeHistogram
+	CreditUpdates     uint64
+	CreditBytes       uint64
+	ZeroCreditReadyNS uint64
+	QueueReadyNS      uint64
+	Closed            bool
+}
+
+type MuxPerformance struct {
+	HandedDATA    SizeHistogram
+	Streams       []MuxStreamPerformance
+	Retired       [64]MuxStreamPerformance
+	RetiredCount  uint64
+	Batches       SizeHistogram
+	BatchMessages uint64
+}
+
+type TransportPerformance struct {
+	CarrierQueueFrames      int
+	CarrierAcceptedBytes    uint64
+	CarrierAcceptedMessages uint64
+	Window                  *WindowPerformance
+	Mux                     *MuxPerformance
+	Media                   *MediaPerformance
+}
+
+var performanceOrigin = time.Now()
+
+func PerformanceTime(now time.Time) int64 { return now.Sub(performanceOrigin).Nanoseconds() }
+
+type MediaPoint struct {
+	NodeNS   int64
+	Stage    string
+	Sequence uint64
+	Attempt  uint32
+	Result   string
+}
+
+type MediaPerformance struct {
+	Points             [128]MediaPoint
+	Count              uint64
+	TLSPlaintextWrites SizeHistogram
+}
+
+func (recorder *Recorder) PerformancePlaintext(size int) {
+	if !PerformanceEnabled || recorder == nil {
+		return
+	}
+	recorder.mu.Lock()
+	defer recorder.mu.Unlock()
+	if recorder.performance == nil {
+		recorder.performance = &MediaPerformance{}
+	}
+	recorder.performance.TLSPlaintextWrites.Add(size)
+}
+
+func (recorder *Recorder) PerformanceSnapshot() *MediaPerformance {
+	if !PerformanceEnabled || recorder == nil {
+		return nil
+	}
+	recorder.mu.Lock()
+	defer recorder.mu.Unlock()
+	return copyValue(recorder.performance)
+}
+
+func (recorder *Recorder) performanceBoundary(point Boundary, now time.Time) {
+	if !PerformanceEnabled || !point.DataKnown || !point.AttemptKnown || point.Direction != "tx" {
+		return
+	}
+	if point.Stage != "carrier_queued" && point.Stage != "carrier_written" && point.Stage != "rtp_written" {
+		return
+	}
+	if recorder.performance == nil {
+		recorder.performance = &MediaPerformance{}
+	}
+	value := recorder.performance
+	value.Points[value.Count%128] = MediaPoint{NodeNS: PerformanceTime(now), Stage: point.Stage, Sequence: point.DataSequence, Attempt: point.Attempt, Result: point.Result}
+	value.Count++
+}
+
+func (recorder *Recorder) PerformanceTag() string {
+	if recorder == nil {
+		return ""
+	}
+	recorder.mu.Lock()
+	defer recorder.mu.Unlock()
+	return recorder.value.SessionTag
+}
