+	data[4] = 2
+	binary.BigEndian.PutUint16(data[6:], 16384)
+	if err := endpoint.SendContext(ctx, data); err != nil {
+		test.Fatal(err)
+	}
+	if endpoint.frames != 3 || endpoint.segments != 1 || endpoint.segmentBytes != 16384 {
+		test.Fatal(endpoint.snapshot(false))
+	}
+}
