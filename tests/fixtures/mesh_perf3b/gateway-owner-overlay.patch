+//go:build fc_perf_diagnostic
+
+package roombroker
+
+import (
+	"bytes"
+	"encoding/hex"
+	"encoding/json"
+	"io"
+	"os"
+	"time"
+)
+
+type ownerGuard struct {
+	Operation string    `json:"operation"`
+	Family    string    `json:"family"`
+	Device    string    `json:"device"`
+	PublicKey string    `json:"public_key"`
+	NotBefore time.Time `json:"not_before"`
+	NotAfter  time.Time `json:"not_after"`
+}
+
+func diagnosticOwner(identity Identity) error {
+	path := os.Getenv("FC_PERF_OWNER_GUARD")
+	if path == "" {
+		return Code("unauthorized")
+	}
+	info, err := os.Lstat(path)
+	if err != nil || !info.Mode().IsRegular() || info.Mode().Perm() != 0600 || info.Size() > 2048 {
+		return Code("unauthorized")
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return Code("unauthorized")
+	}
+	return checkOwnerGuard(raw, identity, time.Now())
+}
+
+func checkOwnerGuard(raw []byte, identity Identity, now time.Time) error {
+	var guard ownerGuard
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.DisallowUnknownFields()
+	if decoder.Decode(&guard) != nil || decoder.Decode(new(any)) != io.EOF {
+		return Code("unauthorized")
+	}
+	key, err := hex.DecodeString(guard.PublicKey)
+	if err != nil || len(key) != len(identity.PublicKey) || len(guard.Operation) == 0 || len(guard.Operation) > 96 ||
+		len(guard.Family) != 32 || len(guard.Device) != 32 || guard.Family != identity.Family || guard.Device != identity.Device ||
+		!bytes.Equal(key, identity.PublicKey[:]) || now.Before(guard.NotBefore) || !now.Before(guard.NotAfter) ||
+		guard.NotAfter.Sub(guard.NotBefore) > 4*time.Hour {
+		return Code("unauthorized")
+	}
+	return nil
+}
