+
+func TestDiagnosticOwnerAfterTLS(test *testing.T) {
+	directory := os.Getenv("FC_FAMILY_TEST_FIXTURES")
+	if directory == "" {
+		test.Fatal("disposable authenticated fixtures required")
+	}
+	broker := makeBroker(test, providerFunc(fresh), gatewayFunc(func(context.Context, context.Context, Room, string, Identity) (Gateway, error) {
+		return &fakeGateway{run: waiting}, nil
+	}), shortLimits())
+	path := filepath.Join(directory, "gateway.json")
+	config, err := ServerTLS(path)
+	if err != nil {
+		test.Fatal(err)
+	}
+	server := httptest.NewUnstartedServer(broker.Handler(path))
+	server.TLS = config
+	server.StartTLS()
+	defer server.Close()
+	for _, name := range []string{"other", "valid"} {
+		raw, err := os.ReadFile(filepath.Join(directory, name+".json"))
+		if err != nil {
+			test.Fatal(err)
+		}
+		client, err := NewClient(server.URL, raw)
+		if err != nil {
+			test.Fatal(err)
+		}
+		descriptor, err := client.Create(context.Background())
+		if name == "other" {
+			if err == nil {
+				test.Fatal("authenticated nonowner admitted")
+			}
+		} else {
+			if err != nil {
+				test.Fatal(err)
+			}
+			client.Cancel(descriptor.SetupID)
+			waitEmpty(test, broker)
+		}
+	}
+}
+
+func TestDiagnosticOwnerGuard(test *testing.T) {
+	now := time.Now().UTC()
+	identity := Identity{Family: strings.Repeat("a", 32), Device: strings.Repeat("b", 32)}
+	identity.PublicKey[0] = 7
+	guard := ownerGuard{Operation: "fixture", Family: identity.Family, Device: identity.Device,
+		PublicKey: hex.EncodeToString(identity.PublicKey[:]), NotBefore: now.Add(-time.Minute), NotAfter: now.Add(time.Hour)}
+	raw, err := json.Marshal(guard)
+	if err != nil || checkOwnerGuard(raw, identity, now) != nil {
+		test.Fatal("owner rejected")
+	}
+	other := identity
+	other.Device = strings.Repeat("c", 32)
+	if checkOwnerGuard(raw, other, now) == nil {
+		test.Fatal("nonowner admitted")
+	}
+	other = identity
+	other.PublicKey[0]++
+	if checkOwnerGuard(raw, other, now) == nil {
+		test.Fatal("wrong key admitted")
+	}
+	other = identity
+	other.Family = strings.Repeat("d", 32)
+	if checkOwnerGuard(raw, other, now) == nil {
+		test.Fatal("wrong family admitted")
+	}
+	for _, clock := range []time.Time{guard.NotBefore.Add(-time.Nanosecond), guard.NotAfter} {
+		if checkOwnerGuard(raw, identity, clock) == nil {
+			test.Fatal("invalid time admitted")
+		}
+	}
+	path := filepath.Join(test.TempDir(), "owner.json")
+	test.Setenv("FC_PERF_OWNER_GUARD", path)
+	if diagnosticOwner(identity) == nil {
+		test.Fatal("missing guard admitted")
+	}
+	if err := os.WriteFile(path, raw, 0600); err != nil {
+		test.Fatal(err)
+	}
+	if diagnosticOwner(identity) != nil {
+		test.Fatal("protected guard rejected")
+	}
+	if err := os.Chmod(path, 0644); err != nil {
+		test.Fatal(err)
+	}
+	if diagnosticOwner(identity) == nil {
+		test.Fatal("insecure guard admitted")
+	}
+	test.Setenv("FC_PERF_OWNER_GUARD", "")
+	if diagnosticOwner(identity) == nil {
+		test.Fatal("unset guard admitted")
+	}
+}
